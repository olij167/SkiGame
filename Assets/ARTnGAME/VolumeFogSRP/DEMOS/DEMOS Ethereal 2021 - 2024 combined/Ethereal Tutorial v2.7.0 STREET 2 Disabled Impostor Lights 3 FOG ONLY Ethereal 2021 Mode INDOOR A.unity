  LightRaySamples: 7
  GlobalFogPower: 1
  GlobalFogNoisePower: 1
  VolumeLightNoisePower: 0
  useTexture3DNoise: 0
  _NoiseTex1: {fileID: 0}
  localLightAttenuation: 0.65
  volumeSamplingNote: Volume sampling X can be set to zero to enable the zero noise
    mode for spot and point light volumes. Set toone to add noise and more even spread
    of the light and may use any amount between zero and one to blend no noise region
    with variable noise amount.
  volumeSamplingControl: {x: 0.38, y: 1, z: 3, w: 1}
  stepControlNote: The steps control X value can be set to a number other than zero
    to enable the steady step volume sampling mode,the number dictates the step distance,
    use zero to have the step depend on scene depth, this mode may create differences
    in the volume basedon the background depth across its length.
  stepsControl: {x: 1.8, y: 27.64, z: 1, w: 4.06}
