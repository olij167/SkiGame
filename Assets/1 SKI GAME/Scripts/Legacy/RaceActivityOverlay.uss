.race-overlay-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(244, 248, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
    pointer-events: none;
}

.race-center-callout {
    position: absolute;
    left: 0;
    right: 0;
    top: 26%;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.race-center-callout-label {
    unity-text-align: middle-center;
    font-size: 62px;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    -unity-text-outline-color: rgba(8, 14, 26, 1);
    -unity-text-outline-width: 4px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.race-panel {
    background-color: rgba(10, 16, 28, 0.95);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    pointer-events: none;
}

.race-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.race-panel-title {
    font-size: 20px;
    color: rgb(248, 251, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.race-modal-title {
    font-size: 20px;
    color: rgb(248, 251, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.race-panel-badge {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: 999px;
    background-color: rgba(91, 196, 255, 0.16);
    color: rgb(176, 229, 255);
    font-size: 11px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.3);
    border-right-color: rgba(91, 196, 255, 0.3);
    border-top-color: rgba(91, 196, 255, 0.3);
    border-bottom-color: rgba(91, 196, 255, 0.3);
}

.race-state-chip {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: 999px;
    background-color: rgba(230, 189, 61, 0.18);
    color: rgb(247, 222, 131);
    font-size: 11px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 189, 61, 0.28);
    border-right-color: rgba(230, 189, 61, 0.28);
    border-top-color: rgba(230, 189, 61, 0.28);
    border-bottom-color: rgba(230, 189, 61, 0.28);
}

.race-body-text {
    white-space: normal;
    color: rgba(244, 248, 255, 0.92);
    font-size: 13px;
    line-height: 17px;
}

.race-muted-text {
    color: rgba(226, 234, 245, 0.74);
}

.race-hint-text {
    color: rgb(241, 199, 74);
    margin-top: 6px;
}

.race-toast-panel {
    position: absolute;
    left: 50%;
    top: 28px;
    translate: -50% 0;
    min-width: 420px;
    max-width: 720px;
    pointer-events: none;
    -unity-text-align: upper-center;
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.race-toast-text {
    font-size: 24px;
    color: rgb(248, 251, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.race-select-panel {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 430px;
    gap: 10px;
}

.race-league-card {
    background-color: rgba(22, 34, 54, 0.94);
    border-radius: 14px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.race-league-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.race-league-copy {
    flex-grow: 1;
    align-items: center;
}

.race-league-name {
    font-size: 18px;
    color: rgb(248, 251, 255);
}

.race-league-status {
    margin-top: 2px;
    font-size: 12px;
    color: rgba(226, 234, 245, 0.74);
}

.race-league-cycle-button,
.race-primary-button,
.race-secondary-button {
    min-height: 36px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
    pointer-events: auto;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(91, 196, 255, 0.95);
    color: rgb(14, 22, 34);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(220, 245, 255, 0.55);
    border-right-color: rgba(220, 245, 255, 0.55);
    border-bottom-color: rgba(220, 245, 255, 0.55);
    border-left-color: rgba(220, 245, 255, 0.55);
}

.race-league-cycle-button {
    min-width: 42px;
}

.race-secondary-button {
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(218, 242, 255);
    border-top-color: rgba(91, 196, 255, 0.36);
    border-right-color: rgba(91, 196, 255, 0.36);
    border-bottom-color: rgba(91, 196, 255, 0.36);
    border-left-color: rgba(91, 196, 255, 0.36);
}

.race-stat-grid {
    flex-direction: row;
    gap: 8px;
    margin-top: 2px;
}

.race-stat-card {
    flex-grow: 1;
    background-color: rgba(24, 36, 58, 0.92);
    border-radius: 12px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.04);
    border-right-color: rgba(255, 255, 255, 0.04);
    border-top-color: rgba(255, 255, 255, 0.04);
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.race-active-stat {
    flex-grow: 1;
    background-color: rgba(24, 36, 58, 0.92);
    border-radius: 12px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.04);
    border-right-color: rgba(255, 255, 255, 0.04);
    border-top-color: rgba(255, 255, 255, 0.04);
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.race-stat-caption {
    font-size: 11px;
    color: rgba(219, 230, 242, 0.66);
    margin-bottom: 2px;
}

.race-stat-value {
    font-size: 16px;
    color: rgb(248, 251, 255);
}

.race-active-value {
    font-size: 16px;
    color: rgb(248, 251, 255);
}

.race-active-panel {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 390px;
}

.race-active-row {
    flex-direction: row;
    gap: 8px;
    margin-top: 4px;
}

.race-progress-track {
    height: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.race-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(91, 196, 255);
    border-radius: 12px;
}

.race-modal-blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(5, 8, 14, 0.58);
    pointer-events: auto;
}

.race-modal-panel {
    width: 560px;
    background-color: rgba(10, 16, 28, 0.98);
    border-radius: 24px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 22px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-left-color: rgba(255, 255, 255, 0.1);
}

.race-modal-body {
    white-space: normal;
    font-size: 16px;
    margin-top: 10px;
    margin-bottom: 12px;
    color: rgba(244, 248, 255, 0.9);
}

.race-modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 16px;
}

.race-hint-prompt.input-prompt {
    justify-content: flex-start;
    align-items: center;
    flex-wrap: nowrap;
    gap: 10px;
    margin-top: 8px;
}

.race-hint-prompt .input-prompt-text,
.race-hint-prompt .input-prompt-separator {
    color: rgb(248, 219, 108);
    font-size: 18px;
    line-height: 22px;
    -unity-font-style: bold;
    -unity-text-outline-color: rgba(24, 14, 4, 1);
    -unity-text-outline-width: 1px;
}

.race-hint-prompt .input-prompt-icon {
    width: 48px;
    height: 48px;
}