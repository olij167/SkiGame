.tutorial-panel {
    position: absolute;
    left: 50%;
    top: 32px;
    translate: -50% 0;
    width: 680px;
    min-height: 210px;
    padding: 18px;
    background-color: rgba(10, 16, 28, 0.95);
    color: rgb(244, 248, 255);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-left-color: rgba(255, 255, 255, 0.1);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.tutorial-panel-complete {
    background-color: rgba(24, 36, 58, 0.96);
    border-top-color: rgba(230, 189, 61, 0.28);
    border-right-color: rgba(230, 189, 61, 0.28);
    border-bottom-color: rgba(230, 189, 61, 0.28);
    border-left-color: rgba(230, 189, 61, 0.28);
}

.tutorial-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.tutorial-progress {
    font-size: 16px;
    color: rgba(226, 235, 246, 0.82);
}

.tutorial-check {
    display: none;
    font-size: 34px;
    color: rgb(247, 224, 140);
}

.tutorial-title {
    font-size: 30px;
    margin-bottom: 8px;
    color: rgb(248, 251, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.tutorial-instruction {
    white-space: normal;
    font-size: 18px;
    margin-bottom: 6px;
    color: rgb(244, 248, 255);
}

.tutorial-hint {
    white-space: normal;
    font-size: 15px;
    margin-bottom: 14px;
    color: rgba(226, 235, 246, 0.78);
}

.tutorial-progress-bar {
    width: 100%;
    height: 14px;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.1);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.tutorial-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(91, 196, 255);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.tutorial-progress-text {
    font-size: 14px;
    color: rgba(226, 235, 246, 0.82);
}

.tutorial-modal {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 600px;
    padding: 24px;
    background-color: rgba(10, 16, 28, 0.97);
    color: rgb(244, 248, 255);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-left-color: rgba(255, 255, 255, 0.1);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.tutorial-modal-title {
    font-size: 30px;
    margin-bottom: 10px;
    color: rgb(248, 251, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.tutorial-modal-body {
    white-space: normal;
    font-size: 16px;
    margin-bottom: 16px;
    color: rgba(244, 248, 255, 0.9);
}

.tutorial-modal-hint {
    font-size: 16px;
    margin-bottom: 6px;
    color: rgb(241, 199, 74);
}

.tutorial-modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 6px;
}

.tutorial-primary-button {
    min-width: 150px;
    min-height: 40px;
    background-color: rgba(91, 196, 255, 0.95);
    color: rgb(14, 22, 34);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(220, 245, 255, 0.55);
    border-right-color: rgba(220, 245, 255, 0.55);
    border-bottom-color: rgba(220, 245, 255, 0.55);
    border-left-color: rgba(220, 245, 255, 0.55);
}

.tutorial-secondary-button {
    min-width: 140px;
    min-height: 40px;
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(91, 196, 255, 0.36);
    border-right-color: rgba(91, 196, 255, 0.36);
    border-bottom-color: rgba(91, 196, 255, 0.36);
    border-left-color: rgba(91, 196, 255, 0.36);
}

.tutorial-modal-blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(5, 8, 14, 0.42);
}