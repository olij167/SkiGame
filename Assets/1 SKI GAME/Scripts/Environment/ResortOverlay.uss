.resort-overlay-panel {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 420px;
    background-color: rgba(10, 16, 28, 0.95);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    padding: 18px;
    color: rgb(244, 248, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    display: none;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.resort-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.resort-header-copy {
    flex-grow: 1;
    margin-right: 12px;
}

.resort-title {
    font-size: 24px;
    margin-bottom: 4px;
    color: rgb(248, 251, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.resort-subtitle {
    font-size: 13px;
    color: rgba(226, 235, 246, 0.78);
}

.resort-time-block {
    align-items: flex-end;
}

.resort-time-caption {
    font-size: 12px;
    color: rgba(226, 235, 246, 0.60);
    margin-bottom: 2px;
}

.resort-time-value {
    font-size: 24px;
    color: rgb(248, 251, 255);
}

.resort-section {
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 12px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    background-color: rgba(24, 36, 58, 0.92);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
    border-left-color: rgba(255, 255, 255, 0.05);
}

.resort-section-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.resort-section-title {
    font-size: 16px;
    color: rgb(248, 251, 255);
}

.resort-section-value {
    font-size: 13px;
    color: rgba(226, 235, 246, 0.78);
}

.resort-progress-bar {
    width: 100%;
    height: 12px;
    background-color: rgba(255, 255, 255, 0.10);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    overflow: hidden;
    margin-bottom: 8px;
}

.resort-progress-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(91, 196, 255);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.resort-body-text {
    font-size: 14px;
    color: rgba(244, 248, 255, 0.88);
    white-space: normal;
}

.resort-button-row {
    flex-direction: row;
    gap: 8px;
    margin-top: 10px;
}

.resort-primary-button {
    flex-grow: 1;
    min-height: 40px;
    background-color: rgba(91, 196, 255, 0.95);
    color: rgb(14, 22, 34);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(220, 245, 255, 0.55);
    border-right-color: rgba(220, 245, 255, 0.55);
    border-bottom-color: rgba(220, 245, 255, 0.55);
    border-left-color: rgba(220, 245, 255, 0.55);
}

.resort-secondary-button {
    flex-grow: 1;
    min-height: 38px;
    background-color: rgba(230, 189, 61, 0.16);
    color: rgb(247, 224, 140);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(230, 189, 61, 0.24);
    border-right-color: rgba(230, 189, 61, 0.24);
    border-bottom-color: rgba(230, 189, 61, 0.24);
    border-left-color: rgba(230, 189, 61, 0.24);
}

.resort-ghost-button {
    margin-top: 10px;
    min-height: 36px;
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(91, 196, 255, 0.30);
    border-right-color: rgba(91, 196, 255, 0.30);
    border-bottom-color: rgba(91, 196, 255, 0.30);
    border-left-color: rgba(91, 196, 255, 0.30);
}

.resort-hint {
    margin-top: 8px;
    font-size: 13px;
    color: rgba(226, 235, 246, 0.66);
    white-space: normal;
}