<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/1%20SKI%20GAME/UI/CustomizationShopView.uss?fileID=7433441132597879392&amp;guid=6936539e6b892ca4c97124473bad740b&amp;type=3#CustomizationShopView" />
    <ui:VisualElement name="Root" class="shop-root">
        <ui:VisualElement class="shop-header">
            <ui:Label name="Lbl_Title" text="Customization" class="shop-title" />
            <ui:VisualElement class="shop-header-right">
                <ui:Label name="Lbl_Currency" text="0" class="shop-currency" />
                <ui:Button name="Btn_Exit" text="Exit" class="shop-exit" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="shop-body">
            <ui:VisualElement name="Panel_Shop" class="shop-panel">
                <ui:VisualElement class="tabs-row">
                    <ui:Button name="Tab_Shop" text="Shop" class="tab-btn is-active" />
                    <ui:Button name="Tab_Inventory" text="Inventory" class="tab-btn" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; max-height: 70%;">
                    <ui:VisualElement name="ShopContent" class="shop-content-column" style="flex-grow: 1;">
                        <ui:Label name="Lbl_ListTitle" text="Today&apos;s Offers" class="panel-title" />
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                            <ui:ListView name="List_Options" class="options-list" style="flex-grow: 1; margin-bottom: 10px; align-self: stretch; height: auto; flex-shrink: 0; max-width: 80%;" />
                            <ui:VisualElement name="Row_SubTabs" class="tabs-row sub" style="flex-wrap: nowrap; flex-direction: column; padding-top: 0; margin-top: 0; align-items: stretch; width: 20%; align-self: flex-start; align-content: flex-start; justify-content: flex-start; flex-grow: 0; min-width: 20%;">
                                <ui:Button name="Tab_Eyes" text="Eyes" class="tab-btn is-active" />
                                <ui:Button name="Tab_Patterns" text="Patterns" class="tab-btn" />
                                <ui:Button name="Tab_Skis" text="Skis" class="tab-btn" />
                                <ui:Button name="Tab_Poles" text="Poles" class="tab-btn" />
                                <ui:Button name="Tab_Hats" text="Hats" class="tab-btn" />
                                <ui:Button name="Tab_Jackets" text="Jackets" class="tab-btn" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="VisualElement" class="detail-panel" style="min-height: 25%; height: 25%;">
                    <ui:Label text="Details" class="panel-title" />
                    <ui:VisualElement class="detail-header">
                        <ui:VisualElement name="Icon_Selected" class="detail-icon" />
                        <ui:VisualElement class="detail-header-text">
                            <ui:Label name="Lbl_SelectedName" text="Select an item" class="detail-name" />
                            <ui:Label name="Lbl_SelectedDesc" class="detail-desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="detail-meta">
                        <ui:Label name="Lbl_SelectedCost" class="detail-meta-line" />
                        <ui:Label name="Lbl_SelectedOwned" class="detail-meta-line" />
                    </ui:VisualElement>
                    <ui:VisualElement name="GearStats" class="gear-stats is-hidden">
                        <ui:Label text="Stats" class="panel-title small" />
                        <ui:Label name="Lbl_GearStatLine1" class="detail-meta-line" />
                        <ui:Label name="Lbl_GearStatLine2" class="detail-meta-line" />
                        <ui:Label name="Lbl_GearStatLine3" class="detail-meta-line" />
                        <ui:Label name="Lbl_GearStatLine4" class="detail-meta-line" />
                        <ui:Label name="Lbl_GearStatLine5" class="detail-meta-line" />
                        <ui:Label name="Lbl_GearStatLine6" class="detail-meta-line" />
                    </ui:VisualElement>
                    <ui:VisualElement class="detail-actions">
                        <ui:Button name="Btn_Buy" text="Buy" class="action-btn primary is-hidden" />
                        <ui:Button name="Btn_Equip" text="Equip" class="action-btn is-hidden" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Panel_Preview" class="preview-panel">
                <ui:Label name="Lbl_PreviewHint" text="Drag to rotate" class="preview-hint" />
            </ui:VisualElement>
            <ui:VisualElement name="Panel_Loadout" class="loadout-panel">
                <ui:Label text="Loadout" class="panel-title" />
                <ui:VisualElement name="Row_Head" class="loadout-top-row">
                    <ui:VisualElement class="skin-mini" style="border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-top-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; flex-shrink: 1; justify-content: center; align-self: auto; align-items: center; align-content: center; width: auto;">
                        <ui:Label text="Skin" class="loadout-title" style="flex-shrink: 1; align-items: center; align-self: center; justify-content: center;" />
                        <ui:VisualElement name="Swatch_SkinColor" class="skin-mini-swatch mini" style="background-color: rgba(255, 255, 255, 0.05); flex-shrink: 0; width: 28px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Row_Eyes" class="gear-mini-row" style="flex-direction: column; align-items: stretch; padding-left: 4px; flex-grow: 1; margin-top: 0; margin-bottom: 0; margin-right: 0; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-top-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149); margin-left: 8px; align-self: stretch;">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between; align-content: flex-start; -unity-text-align: upper-left;">
                            <ui:Label text="Eyes" class="loadout-title" />
                            <ui:Label name="Lbl_EyeState" text="EQUIPPED" class="loadout-badge is-equipped" style="position: relative; align-self: center; flex-grow: 0; flex-shrink: 0;" />
                            <ui:Button name="Btn_ClearEyePreview" text="✕" class="preview-clear-btn" />

                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between; align-items: auto; align-self: auto; background-color: rgba(0, 0, 0, 0); flex-shrink: 0; width: auto; align-content: flex-start;">
                            <ui:VisualElement name="Swatch_EyeColor" class="color-swatch mini" style="justify-content: flex-start; align-content: flex-start; align-self: flex-start; margin-left: 0; flex-grow: 1; width: auto; flex-shrink: 0; align-items: flex-start; min-width: 30%; max-width: none; margin-right: 8px; background-color: rgba(255, 255, 255, 0.05);" />
                            <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; background-color: rgba(255, 255, 255, 0.05);">
                                <ui:Image name="Icon_EyeIcon" class="loadout-icon mini" style="align-self: flex-end; margin-left: 0; flex-shrink: 0;" />
                                <ui:Label name="Lbl_EyeName" text="Default" class="loadout-sub" style="flex-wrap: wrap; flex-grow: 1; -unity-text-align: lower-left;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Row_Skis" class="gear-mini-row" style="border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-top-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 0;">
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:VisualElement name="Slot_SkisGear" style="flex-grow: 1; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Skis" class="loadout-title" />
                            <ui:Label name="Lbl_SkisGearName" text="Default" class="loadout-sub" />
                            <ui:Label name="Lbl_SkisState" text="EQUIPPED" class="loadout-badge is-equipped" style="position: relative; flex-grow: 0; align-self: center; justify-content: flex-start; display: flex; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                            <ui:Button name="Btn_ClearSkisPreview" text="✕" class="preview-clear-btn" />

                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 0; flex-direction: row; margin-top: 2px;">
                            <ui:VisualElement name="Swatch_SkisColor" class="gear-mini-color" style="background-color: rgba(255, 255, 255, 0.05); height: 28px; justify-content: flex-start; align-items: flex-end; align-self: flex-end; align-content: flex-end; width: 64px; flex-direction: column;">
                                <ui:VisualElement class="color-swatch mini" style="align-self: stretch; justify-content: space-around; align-items: center; flex-direction: row; flex-grow: 1; flex-shrink: 0; height: auto; padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; display: none;" />
                                <ui:Button name="Btn_ResetSkisColor" text="↺" class="reset-btn" />
                            </ui:VisualElement>
                            <ui:Button name="Slot_SkisPattern" class="gear-mini-pattern" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(255, 255, 255, 0.05); flex-grow: 1; flex-shrink: 1; width: auto; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; align-self: flex-start; justify-content: flex-start;">
                                <ui:Button name="Icon_SkisPattern" class="pattern-thumb" style="width: 56px; flex-grow: 0; flex-shrink: 0; flex-direction: column; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                                    <ui:Button name="Btn_ResetSkisPattern" text="↺" class="reset-btn" style="align-content: flex-start; align-self: flex-end;" />
                                </ui:Button>
                                <ui:Label name="Lbl_SkisPatternName" text="Default" class="loadout-sub" style="flex-grow: 1;" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Row_Poles" class="gear-mini-row" style="border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-top-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 0;">
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:VisualElement name="Slot_PolesGear" style="flex-grow: 1; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Poles" class="loadout-title" />
                            <ui:Label name="Lbl_PolesGearName" text="Default" class="loadout-sub" />
                            <ui:Label name="Lbl_PolesState" text="EQUIPPED" class="loadout-badge is-equipped" style="position: relative; align-self: flex-end; justify-content: center; flex-grow: 0; align-items: flex-start; align-content: flex-start;" />
                            <ui:Button name="Btn_ClearPolesPreview" text="✕" class="preview-clear-btn" />

                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 0; flex-direction: row; margin-top: 2px;">
                            <ui:VisualElement name="Swatch_PolesColor" class="gear-mini-color">
                                <ui:VisualElement class="color-swatch mini" style="height: auto; flex-grow: 1; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; display: none;" />
                                <ui:Button name="Btn_ResetPolesColor" text="↺" class="reset-btn" />
                            </ui:VisualElement>
                            <ui:Button name="Slot_PolesPattern" class="gear-mini-pattern" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; flex-shrink: 1; flex-grow: 1; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 6px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; justify-content: flex-start;">
                                <ui:Button name="Icon_PolesPattern" class="pattern-thumb" style="width: 56px; flex-grow: 0;">
                                    <ui:Button name="Btn_ResetPolesPattern" text="↺" class="reset-btn" style="align-content: flex-start; align-self: flex-end;" />
                                </ui:Button>
                                <ui:Label name="Lbl_PolesPatternName" text="Default" class="loadout-sub" style="-unity-text-align: middle-left; flex-grow: 1;" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Row_Hat" class="gear-mini-row" style="border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-top-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 0;">
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:VisualElement name="Slot_HatGear" style="flex-grow: 1; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Hat" class="loadout-title" />
                            <ui:Label name="Lbl_HatGearName" text="Default" class="loadout-sub" />
                            <ui:Label name="Lbl_HatState" text="EQUIPPED" class="loadout-badge is-equipped" style="position: relative; flex-grow: 0; justify-content: flex-end; align-self: center;" />
                            <ui:Button name="Btn_ClearHatPreview" text="✕" class="preview-clear-btn" />

                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 0; flex-direction: row; margin-top: 2px;">
                            <ui:VisualElement name="Swatch_HatColor" class="gear-mini-color">
                                <ui:VisualElement class="color-swatch mini" style="height: auto; flex-grow: 1; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; display: none;" />
                                <ui:Button name="Btn_ResetHatColor" text="↺" class="reset-btn" />
                            </ui:VisualElement>
                            <ui:Button name="Slot_HatPattern" class="gear-mini-pattern" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: auto; flex-grow: 1; flex-shrink: 1; flex-direction: row; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 6px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; justify-content: flex-start;">
                                <ui:Button name="Icon_HatPattern" class="pattern-thumb">
                                    <ui:Button name="Btn_ResetHatPattern" text="↺" class="reset-btn" style="align-content: flex-start; align-self: flex-end;" />
                                </ui:Button>
                                <ui:Label name="Lbl_HatPatternName" text="Default" class="loadout-sub" style="-unity-text-align: middle-left;" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Row_Jacket" class="gear-mini-row" style="border-left-color: rgb(149, 149, 149); border-right-color: rgb(149, 149, 149); border-top-color: rgb(149, 149, 149); border-bottom-color: rgb(149, 149, 149); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 0;">
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:VisualElement name="Slot_JacketGear" style="flex-grow: 1; flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Jacket" class="loadout-title" />
                            <ui:Label name="Lbl_JacketGearName" text="Default" class="loadout-sub" />
                            <ui:Label name="Lbl_JacketState" text="EQUIPPED" class="loadout-badge is-equipped" style="position: relative; flex-grow: 0; align-self: center;" />
                            <ui:Button name="Btn_ClearJacketPreview" text="✕" class="preview-clear-btn" />

                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 0; flex-direction: row; margin-top: 2px;">
                            <ui:VisualElement name="Swatch_JacketColor" class="gear-mini-color">
                                <ui:VisualElement class="color-swatch mini" style="height: auto; flex-grow: 1; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; display: none;" />
                                <ui:Button name="Btn_ResetJacketColor" text="↺" class="reset-btn" />
                            </ui:VisualElement>
                            <ui:Button name="Slot_JacketPattern" class="gear-mini-pattern" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; flex-grow: 1; flex-shrink: 1; width: auto; flex-direction: row; justify-content: space-around; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                                <ui:Button name="Icon_JacketPattern" class="pattern-thumb">
                                    <ui:Button name="Btn_ResetJacketPattern" text="↺" class="reset-btn" style="align-content: flex-start; align-self: flex-end;" />
                                </ui:Button>
                                <ui:Label name="Lbl_JacketPatternName" text="Default" class="loadout-sub" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ColorOverlay" class="color-overlay is-hidden">
                <ui:VisualElement name="ColorPanel" class="color-popover" style="width: 310px; display: flex;">
                    <ui:VisualElement class="color-popover-header">
                        <ui:Label name="Lbl_ColorTitle" text="Colour" class="panel-title" />
                        <ui:Button name="Btn_CloseColor" text="✕" class="tab-btn" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Swatch_ColorPreview" class="color-preview" />
                    <ui:VisualElement class="hsv-row">
                        <ui:Label text="H" class="hsv-label" />
                        <ui:Slider name="Sld_H" low-value="0" high-value="1" class="color-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hsv-row">
                        <ui:Label text="S" class="hsv-label" />
                        <ui:Slider name="Sld_S" low-value="0" high-value="1" class="color-slider" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hsv-row">
                        <ui:Label text="V" class="hsv-label" />
                        <ui:Slider name="Sld_V" low-value="0" high-value="1" class="color-slider" />
                    </ui:VisualElement>
                    <ui:Label text="Presets" class="panel-title small" />
                    <ui:VisualElement name="Row_ColorPresets" class="color-presets" style="flex-grow: 1; justify-content: center;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
