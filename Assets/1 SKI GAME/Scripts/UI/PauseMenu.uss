.pause-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.42);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-shell {
    width: 1100px;
    max-width: 94%;
    height: 680px;
    max-height: 92%;
    flex-direction: row;
    gap: 18px;
}

.pause-sidebar {
    width: 260px;
    padding: 18px;
    border-radius: 20px;
    background-color: rgba(10, 14, 22, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.pause-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(245, 248, 252);
    margin-bottom: 6px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.pause-subtitle {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.64);
    margin-bottom: 18px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-nav {
    gap: 10px;
}

.pause-nav-button {
    min-height: 44px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.92);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-nav-button.is-active {
    background-color: rgba(120, 190, 255, 0.18);
}

.pause-main {
    flex-grow: 1;
    padding: 20px;
    border-radius: 20px;
    background-color: rgba(10, 14, 22, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.pause-page-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(245, 248, 252);
    margin-bottom: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.pause-button-list {
    gap: 10px;
}

.pause-action-button {
    min-height: 48px;
    border-radius: 14px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-scroll {
    flex-grow: 1;
    overflow: hidden;
}

.pause-section {
    margin-bottom: 16px;
    padding: 14px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.04);
}

.pause-section-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(245, 248, 252);
    margin-bottom: 10px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-section-body {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.76);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-setting-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
}

.pause-setting-label {
    width: 180px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.84);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-setting-value {
    width: 70px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: upper-right;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-setting-slider,
.pause-setting-dropdown,
.pause-setting-toggle {
    flex-grow: 1;
}

.pause-controls-note {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-rebind-list {
    gap: 8px;
}

.pause-rebind-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    margin-bottom: 8px;
}

.pause-rebind-action {
    width: 220px;
    font-size: 14px;
    color: rgb(245, 248, 252);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-rebind-binding {
    flex-grow: 1;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.76);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pause-rebind-button {
    min-width: 110px;
    min-height: 38px;
    border-radius: 10px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.is-hidden {
    display: none;
}