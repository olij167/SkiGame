.tutorial-panel {
    position: absolute;
    left: 50%;
    top: 32px;
    translate: -50% 0;
    width: 680px;
    min-height: 210px;
    background-color: rgba(8, 12, 18, 0.95);
    border-radius: 22px;
    padding: 18px;
    color: rgb(245, 245, 245);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-left-color: rgba(255, 255, 255, 0.1);
}

.tutorial-panel-complete {
    background-color: rgba(26, 96, 46, 0.96);
}

.tutorial-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.tutorial-progress {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.82);
}

.tutorial-check {
    display: none;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(219, 255, 219);
}

.tutorial-title {
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.tutorial-instruction {
    white-space: normal;
    font-size: 18px;
    margin-bottom: 6px;
}

.tutorial-hint {
    white-space: normal;
    color: rgba(255, 255, 255, 0.76);
    font-size: 15px;
    margin-bottom: 14px;
}

.tutorial-progress-bar {
    width: 100%;
    height: 14px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    margin-bottom: 8px;
}

.tutorial-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(93, 190, 255);
    border-radius: 999px;
}

.tutorial-progress-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.82);
}

.tutorial-modal {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 600px;
    background-color: rgba(7, 12, 18, 0.97);
    border-radius: 24px;
    padding: 24px;
    color: rgb(245, 245, 245);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-left-color: rgba(255, 255, 255, 0.1);
}

.tutorial-modal-title {
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.tutorial-modal-body {
    white-space: normal;
    font-size: 16px;
    margin-bottom: 16px;
    color: rgba(255, 255, 255, 0.86);
}

.tutorial-modal-hint {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 238, 160);
    margin-bottom: 6px;
}

.tutorial-modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 6px;
}

.tutorial-primary-button {
    min-width: 150px;
    min-height: 40px;
    color: rgb(27, 27, 27);
    -unity-font-style: bold;
}

.tutorial-secondary-button {
    min-width: 140px;
    min-height: 40px;
    color: rgb(27, 27, 27);
    -unity-font-style: bold;
}

.tutorial-modal-blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.42);
}

.tutorial-modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 6px;
}

.tutorial-primary-button {
    min-width: 150px;
    min-height: 40px;
}

.tutorial-secondary-button {
    min-width: 140px;
    min-height: 40px;
}

.movement-panel {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 320px;
    background-color: rgba(8, 12, 18, 0.88);
    border-radius: 16px;
    padding: 12px;
    color: rgb(245, 245, 245);
}

.movement-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.movement-list {
    gap: 4px;
}

.input-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    min-height: 26px;
    margin-bottom: 4px;
}

.input-row-name {
    color: rgba(255, 255, 255, 0.9);
    width: 44%;
    white-space: normal;
}

.input-row-binding {
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: bold;
    width: 54%;
    white-space: normal;
    unity-text-align: upper-right;
}

.world-prompt-panel {
    position: absolute;
    left: 50%;
    bottom: 100px;
    translate: -50% 0;
    min-width: 220px;
    background-color: rgba(0, 0, 0, 0.82);
    border-radius: 14px;
    padding: 10px 14px;
    align-items: center;
    color: white;
}

.world-prompt-action {
    -unity-font-style: bold;
    font-size: 16px;
}

.world-prompt-description {
    color: rgba(255, 255, 255, 0.75);
}

.input-row-active {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

.input-row-name-active {
    color: rgb(255, 238, 160);
}

.input-row-binding-active {
    color: rgb(255, 238, 160);
}

.input-row {
    transition-duration: 0.08s;
}

.input-row-name {
    transition-duration: 0.08s;
}

.input-row-binding {
    transition-duration: 0.08s;
}

.tutorial-objective-indicator {
    position: absolute;
    min-width: 180px;
    background-color: rgba(6, 10, 16, 0.88);
    border-radius: 16px;
    padding: 8px 12px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(93, 190, 255, 0.45);
    border-right-color: rgba(93, 190, 255, 0.45);
    border-bottom-color: rgba(93, 190, 255, 0.45);
    border-left-color: rgba(93, 190, 255, 0.45);
}

.tutorial-objective-label {
    color: rgb(240, 248, 255);
    -unity-font-style: bold;
    font-size: 14px;
    unity-text-align: middle-center;
}

    .nav-hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 18px;
    align-items: center;
}

.nav-hud-panel {
    min-width: 300px;
    max-width: 420px;
    background-color: rgba(6, 10, 16, 0.92);
    border-radius: 18px;
    padding: 10px 14px 12px 14px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(93, 190, 255, 0.45);
    border-right-color: rgba(93, 190, 255, 0.45);
    border-bottom-color: rgba(93, 190, 255, 0.45);
    border-left-color: rgba(93, 190, 255, 0.45);
}

.nav-hud-title {
    color: rgb(240, 248, 255);
    -unity-font-style: bold;
    font-size: 15px;
    unity-text-align: middle-center;
}

.nav-hud-meta-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
}

.nav-hud-distance {
    color: rgba(208, 224, 240, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
}

.nav-hud-bearing {
    color: rgba(208, 224, 240, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    unity-text-align: middle-right;
}

.nav-hud-track {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.nav-hud-track-edge {
    color: rgba(190, 214, 232, 0.80);
    font-size: 12px;
    min-width: 14px;
    unity-text-align: middle-center;
}

.nav-hud-track-line {
    position: relative;
    flex-grow: 1;
    height: 8px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
}

.nav-hud-needle {
    position: absolute;
    top: -4px;
    left: 0;
    width: 18px;
    height: 16px;
    background-color: rgb(93, 190, 255);
    border-radius: 6px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.55);
    border-right-color: rgba(255, 255, 255, 0.55);
    border-bottom-color: rgba(255, 255, 255, 0.55);
    border-left-color: rgba(255, 255, 255, 0.55);
}

.navigation-indicator-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.navigation-edge-indicator {
    position: absolute;
    min-width: 180px;
    max-width: 260px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(6, 10, 16, 0.92);
    border-radius: 18px;
    padding: 8px 12px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(93, 190, 255, 0.45);
    border-right-color: rgba(93, 190, 255, 0.45);
    border-bottom-color: rgba(93, 190, 255, 0.45);
    border-left-color: rgba(93, 190, 255, 0.45);
}

.navigation-arrow-label {
    min-width: 22px;
    margin-right: 10px;
    color: rgb(93, 190, 255);
    -unity-font-style: bold;
    font-size: 20px;
    unity-text-align: middle-center;
}

.navigation-indicator-labels {
    flex-direction: column;
    flex-grow: 1;
}

.navigation-indicator-title {
    color: rgb(240, 248, 255);
    -unity-font-style: bold;
    font-size: 14px;
}

.navigation-indicator-distance {
    color: rgba(208, 224, 240, 0.95);
    font-size: 12px;
    margin-top: 2px;
}