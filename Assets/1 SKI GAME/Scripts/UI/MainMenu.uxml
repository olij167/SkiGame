<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project://database/Assets/1%20SKI%20GAME/Scripts/UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=5eda19afd96ffa44a900c7c338707bda&amp;type=3#MainMenu" />
    <ui:VisualElement name="Root" class="root">
        <ui:VisualElement name="Background" class="background" />
        <ui:VisualElement name="Shell" class="shell">
            <ui:VisualElement name="Panel_Home" class="screen home-screen">
                <ui:VisualElement class="hero-card">
                    <ui:Label text="SKI TRIP" class="hero-title" style="-unity-font-definition: url(&quot;project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&amp;guid=281591823e5a02d439cd5679a23ed27e&amp;type=3#Slackey&quot;);" />
                    <ui:Label text="Let&apos;s hit the slopes!" class="hero-subtitle" style="-unity-font-definition: url(&quot;project://database/Assets/Lots%20of%20fonts/monkey-fingers/MonkeyFingersNF.otf?fileID=12800000&amp;guid=3f61c9e0b3f59874f8b5f7f125916820&amp;type=3#MonkeyFingersNF&quot;); font-size: 24px; display: none;" />
                    <ui:VisualElement class="hero-actions">
                        <ui:Button name="Button_Play" text="Play" class="menu-button menu-button-primary" />
                        <ui:Button name="Button_OpenSettings" text="Settings" class="menu-button" />
                        <ui:Button name="Button_OpenControls" text="Controls" class="menu-button" />
                        <ui:Button name="Button_Quit" text="Quit" class="menu-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Panel_Play" class="screen" style="display: none;">
                <ui:VisualElement class="page-card">
                    <ui:VisualElement class="page-header">
                        <ui:Label text="Play" class="page-title" />
                        <ui:Button name="Button_BackFromPlay" text="Back" class="small-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="content-row">
                        <ui:VisualElement class="slot-column">
                            <ui:Button name="Button_Slot_0" class="slot-button">
                                <ui:VisualElement class="slot-content">
                                    <ui:Label name="Label_SlotTitle_0" text="Save 1" class="slot-title" />
                                    <ui:Label name="Label_SlotSub_0" text="Start a new game" class="slot-sub" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="Button_Slot_1" class="slot-button">
                                <ui:VisualElement class="slot-content">
                                    <ui:Label name="Label_SlotTitle_1" text="Save 2" class="slot-title" />
                                    <ui:Label name="Label_SlotSub_1" text="Start a new game" class="slot-sub" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Button name="Button_Slot_2" class="slot-button">
                                <ui:VisualElement class="slot-content">
                                    <ui:Label name="Label_SlotTitle_2" text="Save 3" class="slot-title" />
                                    <ui:Label name="Label_SlotSub_2" text="Start a new game" class="slot-sub" />
                                </ui:VisualElement>
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement class="preview-column">
                            <ui:Label name="Label_PlayHeader" text="Save Slot 1" class="preview-heading" />
                            <ui:Label name="Label_PreviewSlotName" text="Save 1" class="preview-title" />
                            <ui:Label name="Label_PreviewSlotState" text="Empty slot" class="preview-subtitle" />
                            <ui:VisualElement class="preview-divider" />
                            <ui:VisualElement class="kv-row">
                                <ui:Label text="Playthrough" class="kv-key" />
                                <ui:Label name="Label_PreviewPlaythrough" text="-" class="kv-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="kv-row">
                                <ui:Label text="Calendar" class="kv-key" />
                                <ui:Label name="Label_PreviewCalendar" text="-" class="kv-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="kv-row">
                                <ui:Label text="Stats" class="kv-key" />
                                <ui:Label name="Label_PreviewStats" text="-" class="kv-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="preview-spacer" />
                            <ui:VisualElement class="preview-actions">
                                <ui:Button name="Button_PrimarySlotAction" text="New Game" class="menu-button menu-button-primary" />
                                <ui:Button name="Button_DeleteSlot" text="Delete Save" class="menu-button menu-button-danger" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Panel_Settings" class="screen" style="display: none;">
                <ui:VisualElement class="page-card">
                    <ui:VisualElement class="page-header">
                        <ui:Label text="Settings" class="page-title" />
                        <ui:Button name="Button_BackFromSettings" text="Back" class="small-button" />
                    </ui:VisualElement>
                    <ui:ScrollView class="settings-scroll">
                        <ui:VisualElement class="settings-group">
                            <ui:Label text="Display" class="group-title" />
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Quality" class="setting-label" />
                                <ui:DropdownField name="Dropdown_Quality" class="setting-dropdown" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="VSync" class="setting-label" />
                                <ui:Toggle name="Toggle_VSync" value="true" class="setting-toggle" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="FPS Cap" class="setting-label" />
                                <ui:DropdownField name="Dropdown_FpsCap" class="setting-dropdown" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Resolution" class="setting-label" />
                                <ui:DropdownField name="Dropdown_Resolution" class="setting-dropdown" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Window Mode" class="setting-label" />
                                <ui:DropdownField name="Dropdown_WindowMode" class="setting-dropdown" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Display" class="setting-label" />
                                <ui:DropdownField name="Dropdown_Display" class="setting-dropdown" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-group">
                            <ui:Label text="Audio" class="group-title" />
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Master Volume" class="setting-label" />
                                <ui:Slider name="Slider_MasterVolume" low-value="0" high-value="1" value="1" class="setting-slider" />
                                <ui:Label name="Label_MasterVolume" text="100%" class="setting-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Music Volume" class="setting-label" />
                                <ui:Slider name="Slider_MusicVolume" low-value="0" high-value="1" value="1" class="setting-slider" />
                                <ui:Label name="Label_MusicVolume" text="100%" class="setting-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="SFX Volume" class="setting-label" />
                                <ui:Slider name="Slider_SfxVolume" low-value="0" high-value="1" value="1" class="setting-slider" />
                                <ui:Label name="Label_SfxVolume" text="100%" class="setting-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-group">
                            <ui:Label text="Controls" class="group-title" />
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Invert Look Y" class="setting-label" />
                                <ui:Toggle name="Toggle_InvertLookY" value="false" class="setting-toggle" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Look Sensitivity" class="setting-label" />
                                <ui:Slider name="Slider_LookSensitivity" low-value="0.25" high-value="3" value="1" class="setting-slider" />
                                <ui:Label name="Label_LookSensitivity" text="1.00x" class="setting-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-group">
                            <ui:Label text="Gameplay" class="group-title" />
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Field of View" class="setting-label" />
                                <ui:Slider name="Slider_Fov" low-value="60" high-value="110" value="85" class="setting-slider" />
                                <ui:Label name="Label_Fov" text="85" class="setting-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Speed Units" class="setting-label" />
                                <ui:DropdownField name="Dropdown_Units" class="setting-dropdown" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-group">
                            <ui:Label text="Accessibility" class="group-title" />
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="UI Scale" class="setting-label" />
                                <ui:Slider name="Slider_UiScale" low-value="0.85" high-value="1.15" value="1" class="setting-slider" />
                                <ui:Label name="Label_UiScale" text="100%" class="setting-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Reduce Motion" class="setting-label" />
                                <ui:Toggle name="Toggle_ReduceMotion" value="false" class="setting-toggle" />
                            </ui:VisualElement>
                            <ui:VisualElement class="setting-row">
                                <ui:Label text="Colour Mode" class="setting-label" />
                                <ui:DropdownField name="Dropdown_ColorAccessibility" class="setting-dropdown" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-actions">
                            <ui:Button name="Button_ResetSettings" text="Reset Defaults" class="menu-button" />
                            <ui:Button name="Button_SaveSettings" text="Save" class="menu-button menu-button-primary" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Panel_Controls" class="screen" style="display: none;">
                <ui:VisualElement class="page-card">
                    <ui:VisualElement class="page-header">
                        <ui:Label text="Controls" class="page-title" />
                        <ui:Button name="Button_BackFromControls" text="Back" class="small-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="controls-toolbar">
                        <ui:Label name="Label_ControlsStatus" text="Select an action to rebind." class="controls-status" />
                        <ui:Button name="Button_ControlsResetBindings" text="Reset Bindings" class="small-button" />
                    </ui:VisualElement>
                    <ui:Label name="Label_ControlsNote" text="Changes are saved automatically." class="controls-note" />
                    <ui:ScrollView class="settings-scroll">
                        <ui:VisualElement name="ControlsRebindList" class="controls-rebind-list" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Modal_DeleteConfirm" class="modal" style="display: none;">
            <ui:VisualElement class="modal-backdrop" />
            <ui:VisualElement class="modal-card">
                <ui:Label text="Delete this save?" class="modal-title" />
                <ui:Label text="This action cannot be undone." class="modal-body" />
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="Button_ConfirmDelete" text="Delete" class="menu-button menu-button-danger" />
                    <ui:Button name="Button_CancelDelete" text="Cancel" class="menu-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
