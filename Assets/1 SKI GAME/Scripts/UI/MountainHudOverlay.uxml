<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/1%20SKI%20GAME/Scripts/UI/MountainHudOverlay.uss?fileID=7433441132597879392&amp;guid=d17abb4f011fafd4891ed5e0c22994e9&amp;type=3#MountainHudOverlay" />
    <ui:VisualElement name="OverlayRoot" class="overlay-root" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="MapHost" class="map-host" style="top: -1px; bottom: 0; right: 0; left: 0;" />
        <ui:Button name="Btn_CloseOverlay" text="✖" class="header-close-button" style="position: absolute; top: 16px; right: 16px; background-color: rgb(220, 20, 60); width: auto; font-size: 24px; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px;" />
        <ui:VisualElement name="TopStrip" class="top-strip panel" style="border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; right: auto;">
            <ui:Label name="Lbl_TopTime" text="--:--" class="top-strip-time" />
            <ui:VisualElement name="TopWeatherGroup" class="top-weather-group" style="flex-direction: row; justify-content: space-between;">
                <ui:Label name="Lbl_TopWeatherIcon" text="☀" class="top-strip-weather-icon" style="-unity-font-style: bold; font-size: 24px;" />
                <ui:Label name="Lbl_TopWeather" text="Weather" class="top-strip-weather" style="-unity-text-align: middle-center;" />
            </ui:VisualElement>
            <ui:Label name="Lbl_TopLocation" text="Mountain Overview" class="top-strip-location" style="font-size: 24px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&amp;guid=281591823e5a02d439cd5679a23ed27e&amp;type=3#Slackey&quot;); -unity-text-align: upper-center;" />
            <ui:Label name="Lbl_TopCurrency" text="$0" class="top-strip-currency" style="-unity-text-align: upper-center;" />
            <ui:Label name="Lbl_TopHint" text="Runs 0 complete" class="top-strip-hint" />
        </ui:VisualElement>
        <ui:VisualElement name="GoalsPanel" class="panel goals-panel floating-panel" style="left: 16px; right: auto; top: 100px; max-height: 700px; height: auto;">
            <ui:VisualElement class="panel-header">
                <ui:Label text="Goals" class="panel-title" />
                <ui:VisualElement class="segmented-row">
                    <ui:Button name="Btn_GoalsQuests" text="Quests" class="segment-button" />
                    <ui:Button name="Btn_GoalsTasks" text="Tasks" class="segment-button is-selected" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="GoalsList" class="goals-list" />
            <ui:VisualElement name="QuestPanel" class="quest-panel" style="display: none;">
                <ui:VisualElement class="goal-subtab-row">
                    <ui:Button name="Btn_QuestCurrent" text="Current" class="goal-subtab-button is-selected" />
                    <ui:Button name="Btn_QuestCompleted" text="Completed" class="goal-subtab-button" />
                </ui:VisualElement>
                <ui:ScrollView name="QuestList" class="quest-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MapSelectionPanel" class="panel map-selection-panel floating-panel" style="display: none;">
            <ui:VisualElement class="selection-main-row">
                <ui:VisualElement name="ContextHero" class="context-hero selection-identity-block">
                    <ui:Label name="Lbl_ContextIcon" text="Map" class="context-icon" />
                    <ui:VisualElement class="context-hero-copy">
                        <ui:VisualElement class="context-title-row">
                            <ui:Label name="Lbl_ContextTitle" text="Selection" class="context-title" />
                            <ui:Label name="Lbl_ContextStatus" text="Selected" class="context-status-pill" />
                        </ui:VisualElement>
                        <ui:Label name="Lbl_ContextBody" text="Select a run, lift, point of interest, or waypoint to inspect it here." class="context-body" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ContextDetailRow" class="selection-detail-row">
                <ui:VisualElement name="ContextMetaRow" class="context-meta-row selection-meta-strip" />
                <ui:VisualElement name="ContextHighlights" class="context-highlights selection-highlight-strip" />
            </ui:VisualElement>
            <ui:VisualElement name="ContextGuidanceBox" class="context-guidance-box selection-guidance-strip">
                <ui:Label name="Lbl_ContextGuidance" text="Map details appear here when something is selected." class="context-guidance" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="OverlayActionStack" class="overlay-action-stack floating-panel">
            <ui:Button name="Btn_OpenStats" text="Stats" class="overlay-action-button" />
            <ui:Button name="Btn_OpenRunHistory" text="Run History" class="overlay-action-button" />
            <ui:VisualElement class="achievement-action-wrap">
                <ui:Button name="Btn_OpenAchievements" text="Achievements" class="overlay-action-button" />
                <ui:Label name="Badge_Achievements" text="!" class="notification-badge" style="display: none;" />
            </ui:VisualElement>
            <ui:Button name="Btn_OpenPasses" text="Ski Passes" class="overlay-action-button" />
            <ui:Button name="Btn_OpenRescue" text="Rescue" class="overlay-action-button" />
        </ui:VisualElement>
        <ui:VisualElement name="UtilityPopupPanel" class="panel utility-popup-panel floating-panel" style="display: none;">
            <ui:VisualElement class="panel-header" style="align-self: stretch; align-items: center; justify-content: space-between;">
                <ui:Label name="Lbl_UtilityPopupTitle" text="Utility" class="panel-title" />
                <ui:Button name="Btn_CloseUtilityPopup" text="✖" class="utility-close-button" style="border-left-color: rgba(91, 196, 255, 0.3); border-right-color: rgba(91, 196, 255, 0.3); border-top-color: rgba(91, 196, 255, 0.3); border-bottom-color: rgba(91, 196, 255, 0.3); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; font-size: 18px; height: 32px; width: auto; flex-shrink: 1; align-items: auto; min-width: auto;" />
            </ui:VisualElement>
            <ui:VisualElement name="StatsPanel" class="stats-panel utility-section" style="display: none;">
                <ui:VisualElement class="panel-header" style="margin-bottom: 4px;">
                    <ui:Label text="Stats" class="panel-title" />
                    <ui:VisualElement class="segmented-row" style="flex-direction: row;">
                        <ui:Button name="Btn_StatsToday" text="Today" class="segment-button is-selected" />
                        <ui:Button name="Btn_StatsLifetime" text="Lifetime" class="segment-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="Lbl_StatsModeSummary" text="Session totals for this outing." class="stats-mode-summary" />
                <ui:VisualElement name="StatsGrid" class="stats-grid" />
            </ui:VisualElement>
            <ui:VisualElement name="RunHistoryPanel" class="run-history-panel utility-section" style="display: none;">
                <ui:Label text="Recent travel log" class="stats-mode-summary" />
                <ui:ScrollView name="RunHistoryList" class="run-history-list" />
            </ui:VisualElement>
            <ui:VisualElement name="PassPanel" class="pass-panel utility-section" style="display: none;">
                <ui:VisualElement class="panel-header pass-panel-header">
                    <ui:Label name="Lbl_PassPanelTitle" text="Mountain Access" class="panel-title" />
                    <ui:VisualElement class="segmented-row pass-tab-row">
                        <ui:Button name="Btn_PassTabInfo" text="Ski Pass" class="segment-button pass-tab-button is-selected" />
                        <ui:Button name="Btn_PassTabRescue" text="Rescue" class="segment-button pass-tab-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="PassInfoView" class="pass-info-view">
                    <ui:ScrollView name="PassCurrentList" class="pass-current-list" />
                    <ui:ScrollView name="PassOverviewList" class="pass-overview-list" />
                </ui:VisualElement>
                <ui:VisualElement name="PassLiftDetailView" class="pass-lift-detail-view" style="display: none;">
                    <ui:VisualElement class="pass-detail-header">
                        <ui:Button name="Btn_PassBack" text="Back" class="mini-button pass-back-button" />
                        <ui:Label name="Lbl_PassDetailTitle" text="Pass Access" class="pass-detail-title" />
                    </ui:VisualElement>
                    <ui:Label name="Lbl_PassDetailMeta" text="Select a pass to inspect its lift access." class="pass-detail-meta" />
                    <ui:ScrollView name="PassLiftList" class="pass-lift-list" />
                </ui:VisualElement>
                <ui:ScrollView name="RescueUtilitiesView" class="rescue-dispatch-panel rescue-dispatch-scroll" style="display: none;">
                    <ui:VisualElement class="rescue-dispatch-content">
                        <ui:VisualElement class="rescue-dispatch-summary-card">
                            <ui:Label name="Lbl_RescueDispatchRank" text="Reach rescue rank 2 to unlock field support." class="rescue-dispatch-meta rescue-dispatch-rank" />
                            <ui:Label name="Lbl_RescueDispatchRefresh" text="Weekly allowances unavailable." class="rescue-dispatch-meta" />
                            <ui:Label name="Lbl_RescueDispatchBeacon" text="No active rescue beacon." class="rescue-dispatch-meta" />
                        </ui:VisualElement>
                        <ui:VisualElement class="rescue-dispatch-actions">
                            <ui:Button name="Btn_RescueMedicalDrop" text="Medical Drop" class="rescue-dispatch-button" />
                            <ui:Button name="Btn_RescueBeacon" text="Place Beacon" class="rescue-dispatch-button" />
                            <ui:Button name="Btn_RescueSnowmobile" text="Dispatch Snowmobile" class="rescue-dispatch-button" />
                            <ui:Button name="Btn_RescueSOS" text="SOS Return to Resort" class="rescue-dispatch-button rescue-sos-button" />
                        </ui:VisualElement>
                        <ui:VisualElement class="rescue-dispatch-status-card">
                            <ui:Label name="Lbl_RescueDispatchStatus" text="Complete rescue missions to unlock mountain-wide support utilities." class="rescue-dispatch-status" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="AchievementModalRoot" class="modal-scrim" style="display: none;">
            <ui:VisualElement name="AchievementModal" class="panel achievement-modal" style="display: flex;">
                <ui:VisualElement class="modal-header">
                    <ui:Label text="Achievements" class="modal-title" />
                    <ui:Button name="Btn_CloseAchievements" text="✖" class="modal-close-button" />
                </ui:VisualElement>
                <ui:VisualElement name="AchievementPanel" class="achievement-panel">
                    <ui:VisualElement name="AchievementHeaderShell" class="achievement-header-shell">
                        <ui:VisualElement name="AchievementCategoryRow" class="achievement-category-row" />
                    </ui:VisualElement>
                    <ui:ScrollView name="AchievementScroll" class="achievement-scroll">
                        <ui:VisualElement name="AchievementGrid" class="achievement-grid" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="OverlayScreenFade" class="overlay-screen-fade" style="display: none; opacity: 0;" />
    </ui:VisualElement>
</ui:UXML>
