}

.selection-highlight-strip .context-highlight-value {
    font-size: 12px;
    line-height: 14px;

    margin-bottom: 2px;

    color: rgb(248, 251, 255);
    -unity-font-style: bold;

    white-space: normal;
    overflow: hidden;
}

.selection-highlight-strip .context-highlight-detail {
    font-size: 9px;
    line-height: 12px;

    color: rgba(223, 244, 255, 0.78);

    white-space: normal;
    overflow: hidden;
}

.selection-guidance-strip {
    width: 100%;
    min-width: 0;

    margin-top: 0;
    margin-bottom: 0;

    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;

    border-radius: 10px;

    background-color: rgba(91, 196, 255, 0.07);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.16);
    border-right-color: rgba(91, 196, 255, 0.16);
    border-top-color: rgba(91, 196, 255, 0.16);
    border-bottom-color: rgba(91, 196, 255, 0.16);

    overflow: hidden;

    flex-grow: 0;
    flex-shrink: 1;
}

.selection-guidance-strip .context-guidance {
    width: 100%;
    min-width: 0;

    font-size: 10px;
    line-height: 13px;

    color: rgba(223, 244, 255, 0.82);

    white-space: normal;
    overflow: hidden;
}

/* ==========================================================================
   Map Selection Panel — compact context detail row optimisation
   Compresses the middle row into a shallow horizontal information rail.
   ========================================================================== */

.selection-detail-row {
    flex-direction: row;
    flex-wrap: nowrap;

    align-items: center;
    align-content: center;
    justify-content: flex-start;

    width: 100%;
    min-width: 0;

    height: 42px;
    min-height: 34px;
    max-height: 46px;

    gap: 6px;

    margin-top: 0;
    margin-bottom: 6px;

    padding: 0;

    overflow: hidden;

    flex-grow: 0;
    flex-shrink: 0;
}

.selection-meta-strip {
    flex-direction: row;
    flex-wrap: nowrap;

    align-items: center;
    align-content: center;
    justify-content: flex-start;

    width: 32%;
    min-width: 190px;
    max-width: 260px;

    height: 100%;
    min-height: 0;
    max-height: 42px;

    gap: 5px;

    margin: 0;
    padding: 0;

    overflow: hidden;

    flex-grow: 0;
    flex-shrink: 1;
}

.selection-highlight-strip {
    flex-direction: row;
    flex-wrap: nowrap;

    align-items: center;
    align-content: center;
    justify-content: flex-start;

    width: 0;
    min-width: 0;
    max-width: none;

    height: 100%;
    min-height: 0;
    max-height: 42px;

    gap: 5px;

    margin: 0;
    padding: 0;

    overflow: hidden;

    flex-grow: 1;
    flex-shrink: 1;
}

/* Compact meta chips: single-line "Label: Value" pills. */
.selection-meta-strip .context-meta-chip,
.selection-meta-strip .context-meta-chip--compact {
    flex-direction: row;
    flex-wrap: nowrap;

    align-items: center;
    justify-content: flex-start;

    width: auto;
    min-width: 0;
    max-width: 118px;

    height: 30px;
    min-height: 30px;
    max-height: 30px;

    padding-left: 7px;
    padding-right: 7px;
    padding-top: 3px;
    padding-bottom: 3px;

    border-radius: 9px;

    overflow: hidden;

    flex-grow: 0;
    flex-shrink: 1;
}

.selection-meta-strip .context-meta-chip-label {
    width: auto;
    min-width: 0;
    max-width: 48px;

    margin-right: 3px;
    margin-bottom: 0;

    font-size: 8px;
    line-height: 10px;

    color: rgba(226, 235, 246, 0.56);

    white-space: nowrap;
    overflow: hidden;

    flex-grow: 0;
    flex-shrink: 1;
}

.selection-meta-strip .context-meta-chip-value {
    width: auto;
    min-width: 0;
    max-width: none;

    margin-bottom: 0;

    font-size: 10px;
    line-height: 12px;

    color: rgb(248, 251, 255);

    white-space: nowrap;
    overflow: hidden;

    flex-grow: 1;
    flex-shrink: 1;
}

/* Compact highlight cards: shallow horizontal summaries. */
.selection-highlight-strip .context-highlight-card,
.selection-highlight-strip .context-highlight-card--compact {
    flex-direction: row;
    flex-wrap: nowrap;

    align-items: center;
    justify-content: flex-start;

    width: 0;
    min-width: 145px;
    max-width: none;

    height: 34px;
    min-height: 34px;
    max-height: 34px;

    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;

    border-radius: 10px;

    overflow: hidden;

    flex-grow: 1;
    flex-shrink: 1;
}

.selection-highlight-strip .context-highlight-title {
    width: auto;
    min-width: 0;
    max-width: 72px;

    margin-right: 4px;
    margin-bottom: 0;

    font-size: 8px;
    line-height: 10px;

    color: rgba(226, 235, 246, 0.58);

    white-space: nowrap;
    overflow: hidden;

    flex-grow: 0;
    flex-shrink: 1;
}

.selection-highlight-strip .context-highlight-value {
    width: auto;
    min-width: 0;
    max-width: 96px;

    margin-right: 5px;
    margin-bottom: 0;

    font-size: 11px;
    line-height: 13px;

    color: rgb(248, 251, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-left;

    white-space: nowrap;
    overflow: hidden;

    flex-grow: 0;
    flex-shrink: 1;
}

.selection-highlight-strip .context-highlight-detail {
    width: 0;
    min-width: 0;
    max-width: none;

    margin-top: 0;
    margin-bottom: 0;

    font-size: 8px;
    line-height: 10px;

    color: rgba(223, 244, 255, 0.66);

    white-space: nowrap;
    overflow: hidden;

    flex-grow: 1;
    flex-shrink: 1;
}

/* Identity-only/empty states should not reserve vertical space for the detail rail. */
.map-selection-panel.has-only-context-identity .selection-detail-row {
    display: none;
}

/* If only meta exists, let it use the compact rail without unsupported :not(...) selectors. */
.map-selection-panel.has-only-context-meta .selection-meta-strip {
    width: 100%;
    max-width: none;
    flex-grow: 1;
}

.map-selection-panel.has-only-context-meta .selection-highlight-strip {
    display: none;
}

/* If only highlights exist, let them use the full compact rail without unsupported :not(...) selectors. */
.map-selection-panel.has-only-context-highlights .selection-meta-strip {
    display: none;
}

.map-selection-panel.has-only-context-highlights .selection-highlight-strip {
    width: 100%;
    flex-grow: 1;
}