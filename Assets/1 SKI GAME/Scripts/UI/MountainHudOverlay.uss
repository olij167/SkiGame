    min-height: 74px;
}

.achievement-card.is-expanded {
    min-height: 142px;
    background:
        linear-gradient(180deg, rgba(91,196,255,0.08) 0%, rgba(255,255,255,0.00) 100%),
        rgba(24, 36, 58, 0.96);
    border-left-color: rgba(91,196,255,0.28);
    border-right-color: rgba(91,196,255,0.28);
    border-top-color: rgba(91,196,255,0.28);
    border-bottom-color: rgba(91,196,255,0.28);
}

.achievement-card.is-complete-unclaimed {
    background:
        linear-gradient(180deg, rgba(230,189,61,0.20) 0%, rgba(230,189,61,0.03) 100%),
        rgba(24, 36, 58, 0.96);
    border-left-color: rgba(255,224,128,0.46);
    border-right-color: rgba(255,224,128,0.46);
    border-top-color: rgba(255,224,128,0.46);
    border-bottom-color: rgba(255,224,128,0.46);
}

.achievement-card.is-complete-claimed {
    background:
        linear-gradient(180deg, rgba(168,132,34,0.16) 0%, rgba(168,132,34,0.03) 100%),
        rgba(24, 36, 58, 0.94);
    border-left-color: rgba(184,148,44,0.32);
    border-right-color: rgba(184,148,44,0.32);
    border-top-color: rgba(184,148,44,0.32);
    border-bottom-color: rgba(184,148,44,0.32);
}

.achievement-card-state.is-claimable {
    background-color: rgba(230,189,61,0.95);
    color: rgb(18,24,34);
}

.achievement-card-state.is-claimed {
    background-color: rgba(145,114,30,0.82);
    color: rgb(249,236,182);
}

.achievement-progress-track {
    height: 6px;
    background-color: rgba(255,255,255,0.08);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 4px;
}

.achievement-progress-fill {
    height: 100%;
    background-color: rgba(91,196,255,0.95);
    border-radius: 999px;
}

.achievement-card-reward {
    margin-top: 6px;
    color: rgba(255,237,170,0.92);
    font-size: 10px;
    white-space: normal;
}

.achievement-claim-button {
    margin-left: auto;
    min-height: 28px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    background-color: rgba(230,189,61,0.95);
    color: rgb(18,24,34);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255,239,179,0.55);
    border-right-color: rgba(255,239,179,0.55);
    border-top-color: rgba(255,239,179,0.55);
    border-bottom-color: rgba(255,239,179,0.55);
}

.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    min-height: 44px;
}

.segmented-row {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: flex-start;
    gap: 6px;
    flex-shrink: 0;
    min-height: 36px;
    height: 36px;
}

.header-close-button,
.segment-button,
.goal-subtab-button,
.pass-level-button,
.mini-button,
.map-layer-button,
.pass-current-button {
    min-height: 32px;
    height: 32px;
    padding-left: 10px;
    padding-right: 10px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.30);
    border-right-color: rgba(91, 196, 255, 0.30);
    border-top-color: rgba(91, 196, 255, 0.30);
    border-bottom-color: rgba(91, 196, 255, 0.30);
}

.header-close-button.is-selected,
.segment-button.is-selected,
.goal-subtab-button.is-selected,
.pass-level-button.is-selected,
.map-layer-button.is-selected {
    background-color: rgba(91, 196, 255, 0.95);
    color: rgb(18, 24, 34);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(220, 245, 255, 0.70);
    border-right-color: rgba(220, 245, 255, 0.70);
    border-top-color: rgba(220, 245, 255, 0.70);
    border-bottom-color: rgba(220, 245, 255, 0.70);
}

.goal-subtab-row,
.achievement-category-row {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: space-between;
    gap: 6px;
    width: 100%;
    min-height: 42px;
    height: 42px;
    margin-top: 2px;
    margin-bottom: 8px;
}

.goal-subtab-button,
.achievement-category-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 42px;
    min-height: 42px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91,196,255,0.22);
    border-right-color: rgba(91,196,255,0.22);
    border-top-color: rgba(91,196,255,0.22);
    border-bottom-color: rgba(91,196,255,0.22);
    background-color: rgba(91,196,255,0.08);
    color: rgba(223,244,255,0.82);
    unity-text-align: middle-center;
    font-size: 10px;
    -unity-font-style: bold;
}

.goal-subtab-button.is-selected,
.achievement-category-button.is-selected {
    background: linear-gradient(180deg, rgba(91,196,255,0.28) 0%, rgba(91,196,255,0.12) 100%);
    color: rgb(248,251,255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(168,226,255,0.52);
    border-right-color: rgba(168,226,255,0.52);
    border-top-color: rgba(168,226,255,0.52);
    border-bottom-color: rgba(168,226,255,0.52);
}

.goals-panel {
    flex-grow: 1;
    min-height: 300px;
    overflow: hidden;
    background:
        linear-gradient(180deg, rgba(91, 196, 255, 0.06) 0%, rgba(10, 16, 28, 0.00) 120px),
        rgba(10, 16, 28, 0.95);
}

.goals-list,
.quest-panel,
.achievement-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.quest-panel {
    flex-direction: column;
    overflow: hidden;
    padding-top: 2px;
}

.quest-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-right: 2px;
}

.achievement-panel {
    flex-direction: column;
}

.achievement-header-shell {
    flex-shrink: 0;
    min-height: 42px;
    height: 42px;
    margin-bottom: 8px;
}

.achievement-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.achievement-grid {
    flex-direction: column;
    width: 100%;
    min-width: 0;
    gap: 6px;
    padding-bottom: 4px;
}

.achievement-card {
    width: 100%;
    min-width: 0;
    padding: 8px 10px;
    border-radius: 14px;
    background:
        linear-gradient(180deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.00) 100%),
        rgba(24, 36, 58, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255,255,255,0.07);
    border-right-color: rgba(255,255,255,0.07);
    border-top-color: rgba(255,255,255,0.07);
    border-bottom-color: rgba(255,255,255,0.07);
    overflow: hidden;
}

.achievement-card.is-compact {
    min-height: 58px;
}

.achievement-card.is-expanded {
    min-height: 132px;
    background:
        linear-gradient(180deg, rgba(91,196,255,0.08) 0%, rgba(255,255,255,0.00) 100%),
        rgba(24, 36, 58, 0.96);
    border-left-color: rgba(91,196,255,0.28);
    border-right-color: rgba(91,196,255,0.28);
    border-top-color: rgba(91,196,255,0.28);
    border-bottom-color: rgba(91,196,255,0.28);
}

.achievement-card-header {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
}

.achievement-card-icon {
    width: 24px;
    min-width: 24px;
    height: 24px;
    border-radius: 7px;
    font-size: 13px;
    padding-top: 1px;
}

.achievement-card-title {
    font-size: 12px;
    color: rgb(248, 251, 255);
}

.achievement-card-subtitle {
    margin-top: 1px;
    font-size: 9px;
    color: rgba(226, 235, 246, 0.70);
    white-space: normal;
}

.achievement-card-state {
    padding: 3px 7px;
    border-radius: 10px;
    font-size: 9px;
    white-space: nowrap;
}

.achievement-progress-track {
    height: 5px;
    background-color: rgba(255,255,255,0.08);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 2px;
}

.achievement-card-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    margin-top: 5px;
}

.achievement-card-progress {
    font-size: 9px;
    color: rgba(226, 235, 246, 0.74);
}

.achievement-card-category {
    font-size: 9px;
    color: rgba(226, 235, 246, 0.60);
    background-color: rgba(255,255,255,0.05);
    border-radius: 10px;
    padding: 2px 6px;
}

.achievement-card-expandhint {
    margin-left: 4px;
    font-size: 12px;
    color: rgba(223,244,255,0.70);
    min-width: 14px;
    unity-text-align: middle-center;
}

.achievement-card.is-compact .achievement-card-category {
    display: none;
}

.achievement-card.is-compact .achievement-card-description,
.achievement-card.is-compact .achievement-card-reward,
.achievement-card.is-compact .achievement-claim-button {
    display: none;
}

.quest-card {
    position: relative;
    margin-bottom: 8px;
    padding: 12px 12px 10px 12px;
    border-radius: 16px;
    background:
        linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.00) 100%),
        rgba(19, 29, 47, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255,255,255,0.09);
    border-right-color: rgba(255,255,255,0.09);
    border-top-color: rgba(255,255,255,0.09);
    border-bottom-color: rgba(255,255,255,0.09);
    overflow: hidden;
}

.quest-card-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    border-top-left-radius: 18px;
    border-bottom-left-radius: 18px;
}

.quest-card.is-tracked {
    background:
        linear-gradient(180deg, rgba(132,214,255,0.12) 0%, rgba(255,255,255,0.00) 100%),
        rgba(20, 31, 50, 0.98);
    border-left-color: rgba(132,214,255,0.34);
    border-right-color: rgba(132,214,255,0.24);
    border-top-color: rgba(132,214,255,0.24);
    border-bottom-color: rgba(132,214,255,0.24);
}

.quest-card.is-completed {
    opacity: 0.82;
}

.quest-card-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 5px;
}

.quest-card-titleblock {
    flex-grow: 1;
    min-width: 0;
}

.quest-card-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(248, 251, 255);
    white-space: normal;
}

.quest-card-subtitle {
    margin-top: 2px;
    font-size: 10px;
    color: rgba(226, 235, 246, 0.74);
    white-space: normal;
}

.quest-card-status {
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 10px;
    white-space: nowrap;
    color: rgb(223, 244, 255);
    background-color: rgba(91, 196, 255, 0.12);
}

.quest-card-status.is-complete {
    color: rgb(247, 224, 140);
    background-color: rgba(230, 189, 61, 0.14);
}

.quest-card-description {
    font-size: 11px;
    line-height: 14px;
    color: rgba(236, 242, 250, 0.86);
    white-space: normal;
    margin-bottom: 8px;
}

.quest-card-stage-description {
    font-size: 10px;
    line-height: 14px;
    color: rgba(208, 220, 236, 0.72);
    white-space: normal;
    margin-bottom: 8px;
}

.quest-card-progress-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
}

.quest-card-progress-label {
    flex-grow: 1;
    min-width: 0;
    font-size: 10px;
    color: rgba(223, 233, 246, 0.76);
}

.quest-card-progress-percent {
    font-size: 10px;
    color: rgba(248, 251, 255, 0.92);
}

.quest-card-progress-track {
    height: 8px;
    margin-bottom: 10px;
    background-color: rgba(255,255,255,0.08);
    border-radius: 999px;
    overflow: hidden;
}

.quest-card-progress-fill {
    height: 100%;
    border-radius: 999px;
}

.quest-objective-list {
    flex-direction: column;
    gap: 6px;
}

.quest-objective-row {
    flex-direction: row;
    align-items: flex-start;
    gap: 9px;
    padding: 8px 10px;
    border-radius: 12px;
    background-color: rgba(17, 26, 42, 0.88);
}

.quest-objective-row.is-complete {
    background-color: rgba(91, 196, 255, 0.10);
}

.quest-objective-check {
    width: 16px;
    min-width: 16px;
    font-size: 11px;
    color: rgba(226, 235, 246, 0.62);
    -unity-text-align: upper-center;
}

.quest-objective-row.is-complete .quest-objective-check {
    color: rgb(247, 224, 140);
}

.quest-objective-copy {
    flex-grow: 1;
    min-width: 0;
}

.quest-objective-prompt {
    align-self: flex-start;
    margin-bottom: 4px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 999px;
    font-size: 10px;
    color: rgb(233, 243, 252);
    -unity-font-style: bold;
}

.quest-objective-title {
    font-size: 12px;
    color: rgb(248, 251, 255);
    white-space: normal;
}

.quest-objective-description {
    margin-top: 3px;
    font-size: 10px;
    line-height: 13px;
    color: rgba(219, 230, 243, 0.68);
    white-space: normal;
}

.quest-objective-progress-track {
    height: 6px;
    margin-top: 7px;
    margin-bottom: 4px;
    background-color: rgba(255,255,255,0.08);
    border-radius: 999px;
    overflow: hidden;
}

.quest-objective-progress-fill {
    height: 100%;
    border-radius: 999px;
}

.quest-objective-progress {
    margin-top: 2px;
    font-size: 10px;
    color: rgba(223, 244, 255, 0.80);
}

.quest-card-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 6px;
}

.quest-track-button {
    min-width: 92px;
    min-height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    background-color: rgba(91, 196, 255, 0.12);
    color: rgb(223, 244, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.24);
    border-right-color: rgba(91, 196, 255, 0.24);
    border-top-color: rgba(91, 196, 255, 0.24);
    border-bottom-color: rgba(91, 196, 255, 0.24);
}

.quest-track-button.is-active {
    background-color: rgba(91, 196, 255, 0.92);
    color: rgb(14, 22, 34);
    border-left-color: rgba(220, 245, 255, 0.55);
    border-right-color: rgba(220, 245, 255, 0.55);
    border-top-color: rgba(220, 245, 255, 0.55);
    border-bottom-color: rgba(220, 245, 255, 0.55);
}

.quest-empty-state {
    font-size: 11px;
    color: rgba(226, 235, 246, 0.70);
    white-space: normal;
    padding: 10px 4px;
}

.rescue-dispatch-panel {
    margin-bottom: 8px;
    padding: 10px;
    border-radius: 12px;
    background-color: rgba(18, 29, 47, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.rescue-dispatch-meta {
    margin-bottom: 3px;
    color: rgba(226, 235, 246, 0.86);
    font-size: 11px;
    white-space: normal;
}

.rescue-dispatch-actions {
    flex-direction: column;
    gap: 6px;
    margin-top: 6px;
}

.rescue-dispatch-button {
    min-height: 30px;
}

.rescue-dispatch-status {
    margin-top: 8px;
    color: rgba(255, 229, 164, 0.92);
    font-size: 11px;
    white-space: normal;
}

    .pass-panel {
    min-height: 280px;
    overflow: hidden;
    gap: 8px;
}

.pass-info-view,
.pass-lift-detail-view {
    flex-grow: 1;
    gap: 8px;
}

.pass-permanent-summary {
    color: rgba(226, 235, 246, 0.86);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 4px;
}

.pass-overview-list,
.pass-lift-list {
    flex-grow: 1;
    min-height: 0;
}

.pass-entry-button,
.pass-lift-button {
    min-height: 54px;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: upper-left;
    justify-content: flex-start;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(24, 36, 58, 0.92);
    color: rgb(244, 248, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    border-radius: 12px;
}

.pass-entry-button.is-current {
    border-left-color: rgba(91, 196, 255, 0.75);
    border-right-color: rgba(91, 196, 255, 0.75);
    border-top-color: rgba(91, 196, 255, 0.75);
    border-bottom-color: rgba(91, 196, 255, 0.75);
}

.pass-entry-button.is-permanent {
    background-color: rgba(230, 189, 61, 0.14);
    border-left-color: rgba(230, 189, 61, 0.45);
    border-right-color: rgba(230, 189, 61, 0.45);
    border-top-color: rgba(230, 189, 61, 0.45);
    border-bottom-color: rgba(230, 189, 61, 0.45);
}

.pass-detail-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.pass-detail-title {
    flex-grow: 1;
    color: rgb(248, 251, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.pass-detail-meta {
    color: rgba(226, 235, 246, 0.82);
    font-size: 11px;
    white-space: normal;
}

.rescue-sos-button {
    background-color: rgba(230, 189, 61, 0.95);
    color: rgb(18, 24, 34);
    border-left-color: rgba(255, 239, 179, 0.55);
    border-right-color: rgba(255, 239, 179, 0.55);
    border-top-color: rgba(255, 239, 179, 0.55);
    border-bottom-color: rgba(255, 239, 179, 0.55);
}

.overlay-screen-fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 1);
    opacity: 0;
    pointer-events: none;
}

.pass-panel {
    min-height: 280px;
    overflow: hidden;
    gap: 6px;
}

.pass-panel-header {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 6px;
    min-height: auto;
    margin-bottom: 6px;
}

.pass-tab-row {
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 6px;
    min-height: 32px;
    height: 32px;
}

.pass-tab-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 32px;
    min-height: 32px;
    padding-left: 6px;
    padding-right: 6px;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.pass-info-view,
.pass-lift-detail-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    gap: 6px;
}

.pass-current {
    font-size: 14px;
    color: rgb(248, 251, 255);
    white-space: normal;
}

.pass-expiry-meta,
.pass-permanent-summary,
.pass-detail-meta {
    font-size: 10px;
    line-height: 14px;
    color: rgba(226, 235, 246, 0.84);
    white-space: normal;
}

.pass-overview-list,
.pass-lift-list,
.rescue-dispatch-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.pass-entry-button,
.pass-lift-button {
    min-height: 44px;
    margin-bottom: 5px;
    padding: 7px 9px;
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-left;
    justify-content: center;
    align-items: flex-start;
    border-radius: 12px;
}

.pass-detail-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
}

.pass-detail-title {
    flex-grow: 1;
    min-width: 0;
    font-size: 14px;
    -unity-text-align: middle-left;
}

.pass-back-button {
    min-width: 60px;
    flex-shrink: 0;
}

.rescue-dispatch-scroll {
    padding-right: 2px;
}

.rescue-dispatch-content {
    flex-direction: column;
    gap: 8px;
    padding-bottom: 4px;
}

.rescue-dispatch-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-bottom: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rescue-dispatch-summary-card,
.rescue-dispatch-status-card {
    padding: 8px 9px;
    border-radius: 12px;
    background-color: rgba(18, 29, 47, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.rescue-dispatch-rank {
    color: rgb(248, 251, 255);
}

.rescue-dispatch-meta {
    margin-bottom: 3px;
    font-size: 10px;
    line-height: 13px;
    color: rgba(226, 235, 246, 0.84);
    white-space: normal;
}

.rescue-dispatch-actions {
    flex-direction: column;
    gap: 5px;
}

.rescue-dispatch-button {
    min-height: 28px;
    height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.rescue-dispatch-status {
    font-size: 10px;
    line-height: 13px;
    color: rgba(255, 229, 164, 0.92);
    white-space: normal;
}

.rescue-sos-button {
    margin-top: 2px;
}

    .pass-panel {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    overflow: hidden;
    min-height: 280px;
    gap: 0;
}

.pass-panel-header {
    flex-shrink: 0;
    flex-grow: 0;
    min-height: auto;
    margin-bottom: 8px;
    padding-bottom: 0;
}

.pass-tab-row {
    flex-shrink: 0;
    flex-grow: 0;
}

.pass-info-view,
.pass-lift-detail-view,
.rescue-dispatch-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 0;
}

.pass-current-list {
    flex-direction: column;
    min-height: 64px;
    max-height: 180px;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.pass-current-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 34px;
    gap: 10px;
    margin-bottom: 6px;
}

.pass-current-row-left {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    max-width: 40%;
    flex-shrink: 1;
    flex-grow: 1;
}

.pass-current-row-right {
    flex-direction: row;
    align-content: stretch;
    align-items: stretch;
    align-self: stretch;
    flex-grow: 1;
    min-width: 132px;
    max-width: 60%;
}

.pass-current-chip {
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    color: rgb(244, 248, 255);
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
    -unity-text-align: middle-center;
    flex-grow: 1;
    flex-shrink: 1;
}

.pass-current-status {
    color: rgb(247, 250, 255);
    font-size: 12px;
    min-width: 72px;
    -unity-text-align: middle-center;
    align-self: stretch;
    flex-grow: 1;
    flex-shrink: 1;
}

.pass-current-progress-wrap {
    position: relative;
    min-width: 168px;
    height: 22px;
    justify-content: center;
    align-content: stretch;
    align-items: stretch;
    align-self: center;
}

.pass-current-progress-track {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(255, 255, 255, 0.08);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.pass-current-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(91, 196, 255, 0.92);
}

.pass-current-progress-label {
    position: relative;
    align-self: center;
    -unity-text-align: middle-center;
    color: rgb(247, 250, 255);
    font-size: 11px;
    flex-grow: 1;
    flex-shrink: 1;
}

.pass-current-empty {
    color: rgba(226, 234, 245, 0.58);
    font-size: 11px;
    margin-top: 2px;
}

.rescue-dispatch-scroll {
    padding-top: 2px;
}

.rescue-dispatch-scroll > .unity-scroll-view__content-container {
    padding-top: 0;
}

.quest-list {
    padding-right: 4px;
}

.quest-card {
    margin-bottom: 6px;
    padding: 8px 10px 8px 10px;
    border-radius: 14px;
    background:
        linear-gradient(180deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.00) 100%),
        rgba(19, 29, 47, 0.95);
}

.quest-card.is-primary {
    background:
        linear-gradient(180deg, rgba(132,214,255,0.18) 0%, rgba(255,255,255,0.00) 100%),
        rgba(22, 34, 55, 0.99);
    border-left-color: rgba(132,214,255,0.42);
    border-right-color: rgba(132,214,255,0.30);
    border-top-color: rgba(132,214,255,0.30);
    border-bottom-color: rgba(132,214,255,0.30);
}

.quest-card.is-collapsed {
    min-height: 0;
}

.quest-card-header {
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2px;
}

.quest-card-header-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    flex-shrink: 0;
}

.quest-card-title {
    font-size: 14px;
    line-height: 15px;
}

.quest-card-subtitle {
    margin-top: 1px;
    font-size: 9px;
    line-height: 11px;
}

.quest-card-pin-indicator {
    margin-top: 4px;
    align-self: flex-start;
    padding: 2px 6px 2px 6px;
    border-radius: 6px;
    background-color: rgba(132,214,255,0.10);
    color: rgba(220,243,255,0.88);
    font-size: 8px;
    letter-spacing: 0.7px;
    -unity-font-style: bold;
}

.quest-expand-button,
.quest-primary-button,
.quest-track-button {
    min-width: 44px;
    height: 22px;
    min-height: 22px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 7px;
    font-size: 9px;
    flex-grow: 0;
    flex-shrink: 0;
    unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(232, 240, 248, 0.86);
    border-left-color: rgba(255,255,255,0.10);
    border-right-color: rgba(255,255,255,0.10);
    border-top-color: rgba(255,255,255,0.10);
    border-bottom-color: rgba(255,255,255,0.10);
}

.quest-track-button:hover {
    background-color: rgba(255,255,255,0.11);
    border-left-color: rgba(255,255,255,0.18);
    border-right-color: rgba(255,255,255,0.18);
    border-top-color: rgba(255,255,255,0.18);
    border-bottom-color: rgba(255,255,255,0.18);
}

.quest-primary-button:hover {
    background-color: rgba(132,214,255,0.12);
    border-left-color: rgba(132,214,255,0.24);
    border-right-color: rgba(132,214,255,0.24);
    border-top-color: rgba(132,214,255,0.24);
    border-bottom-color: rgba(132,214,255,0.24);
    color: rgba(240,248,255,0.96);
}

.quest-card-prompt {
    align-self: flex-start;
    margin-bottom: 4px;
    padding: 3px 6px 3px 6px;
    border-radius: 6px;
    font-size: 9px;
    line-height: 11px;
    color: rgb(233, 243, 252);
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255,255,255,0.06);
    border-right-color: rgba(255,255,255,0.06);
    border-top-color: rgba(255,255,255,0.06);
    border-bottom-color: rgba(255,255,255,0.06);
}

.quest-card-progress-row {
    margin-bottom: 3px;
}

.quest-card-progress-label,
.quest-card-progress-percent {
    font-size: 9px;
}

.quest-card-progress-track {
    height: 5px;
