    display: none;
}

.achievement-card.is-compact .achievement-card-reward {
    display: none;
}

.achievement-card.is-compact .achievement-claim-button {
    display: none;
}

.quest-card {
    position: relative;
    margin-bottom: 8px;
    padding: 12px 12px 10px 12px;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 100%), rgba(19, 29, 47, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.09);
    border-right-color: rgba(255, 255, 255, 0.09);
    border-top-color: rgba(255, 255, 255, 0.09);
    border-bottom-color: rgba(255, 255, 255, 0.09);
    overflow: hidden;
}

.quest-card-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    border-top-left-radius: 18px;
