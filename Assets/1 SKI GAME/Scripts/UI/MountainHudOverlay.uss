.overlay-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(244, 248, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.map-viewport {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.map-content {
    position: absolute;
    left: 0;
    top: 0;
    width: 1024px;
    height: 1024px;
}

.map-background {
    position: absolute;
    left: 0;
    top: 0;
    width: 1024px;
    height: 1024px;
}

.map-polylines {
    position: absolute;
    left: 0;
    top: 0;
    width: 1024px;
    height: 1024px;
}

.map-markers {
    position: absolute;
    left: 0;
    top: 0;
    width: 1024px;
    height: 1024px;
}

.panel {
    background-color: rgba(10, 16, 28, 0.95);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.top-strip {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 42px;
}

.top-strip-time {
    font-size: 18px;
    min-width: 80px;
    color: rgb(248, 251, 255);
}

.top-strip-weather {
    min-width: 150px;
    color: rgba(226, 235, 246, 0.92);
}

.top-strip-location {
    flex-grow: 1;
    color: rgb(248, 251, 255);
}

.top-strip-currency {
    min-width: 120px;
    color: rgba(255, 225, 136, 0.98);
    unity-text-align: middle-center;
}

.top-strip-hint {
    color: rgba(226, 235, 246, 0.78);
}

.left-rail {
    position: absolute;
    left: 16px;
    top: 66px;
    bottom: 16px;
    width: 330px;
    gap: 12px;
}

.right-rail {
    position: absolute;
    right: 16px;
    top: 66px;
    bottom: 16px;
    width: 340px;
    gap: 12px;
}

.dock-panel {
    margin-bottom: 12px;
}

.context-panel {
    flex-grow: 1;
    min-height: 260px;
}

.stats-panel {
    min-height: 180px;
    overflow: hidden;
}

.goals-panel {
    flex-grow: 1;
    min-height: 300px;
}

.pass-panel {
    min-height: 220px;
    overflow: hidden;
}

.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.panel-title {
    font-size: 16px;
    color: rgb(248, 251, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.context-panel {
    flex-grow: 1;
    min-height: 260px;
    padding-bottom: 12px;
    background: linear-gradient(180deg, rgba(24, 36, 58, 0.42) 0%, rgba(10, 16, 28, 0) 120px), rgba(10, 16, 28, 0.95);
}

.stats-panel {
    min-height: 180px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(91, 196, 255, 0.06) 0%, rgba(10, 16, 28, 0) 110px), rgba(10, 16, 28, 0.95);
}

.goals-panel {
    flex-grow: 1;
    min-height: 300px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(91, 196, 255, 0.06) 0%, rgba(10, 16, 28, 0) 120px), rgba(10, 16, 28, 0.95);
}

.context-hero {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
    padding: 10px;
    border-radius: 12px;
    background-color: rgba(24, 36, 58, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.context-icon {
    width: 34px;
    min-width: 34px;
    height: 34px;
    margin-right: 8px;
    padding-top: 4px;
    border-radius: 10px;
    background-color: rgba(91, 196, 255, 0.12);
    color: rgb(223, 244, 255);
    unity-text-align: middle-center;
    font-size: 16px;
    display: flex;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.2);
    border-right-color: rgba(91, 196, 255, 0.2);
    border-top-color: rgba(91, 196, 255, 0.2);
    border-bottom-color: rgba(91, 196, 255, 0.2);
}

.context-panel {
    flex-grow: 1;
    min-height: 260px;
    padding-bottom: 10px;
    background: linear-gradient(180deg, rgba(24, 36, 58, 0.34) 0%, rgba(10, 16, 28, 0) 95px), rgba(10, 16, 28, 0.95);
}

.context-hero {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
    padding: 8px 10px;
    border-radius: 12px;
    background-color: rgba(24, 36, 58, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.context-icon {
    width: 30px;
    min-width: 30px;
    height: 30px;
    margin-right: 8px;
    padding-top: 3px;
    border-radius: 9px;
    background-color: rgba(91, 196, 255, 0.12);
    color: rgb(223, 244, 255);
    unity-text-align: middle-center;
    font-size: 14px;
    display: flex;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.18);
    border-right-color: rgba(91, 196, 255, 0.18);
    border-top-color: rgba(91, 196, 255, 0.18);
    border-bottom-color: rgba(91, 196, 255, 0.18);
}

.context-hero-copy {
    flex-grow: 1;
    min-width: 0;
}

.context-title-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    margin-bottom: 2px;
}

.context-title {
    flex-grow: 1;
    min-width: 0;
    font-size: 15px;
    margin-bottom: 0;
    color: rgb(248, 251, 255);
    white-space: normal;
}

.context-status-pill {
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 3px;
    padding-bottom: 3px;
    min-height: 18px;
    border-radius: 12px;
    font-size: 9px;
    color: rgb(247, 224, 140);
    background-color: rgba(230, 189, 61, 0.14);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 189, 61, 0.2);
    border-right-color: rgba(230, 189, 61, 0.2);
    border-top-color: rgba(230, 189, 61, 0.2);
    border-bottom-color: rgba(230, 189, 61, 0.2);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.context-body {
    white-space: normal;
    line-height: 15px;
    color: rgba(244, 248, 255, 0.86);
    font-size: 11px;
    max-height: 32px;
    overflow: hidden;
}

.context-guidance-box {
    margin-bottom: 6px;
    padding: 6px 8px;
    border-radius: 10px;
    background-color: rgba(91, 196, 255, 0.07);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.16);
    border-right-color: rgba(91, 196, 255, 0.16);
    border-top-color: rgba(91, 196, 255, 0.16);
    border-bottom-color: rgba(91, 196, 255, 0.16);
}

.context-guidance {
    color: rgba(223, 244, 255, 0.86);
    font-size: 10px;
    line-height: 14px;
    white-space: normal;
    max-height: 28px;
    overflow: hidden;
}

.context-meta-row {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 6px;
}

.context-meta-chip {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: 11px;
    background-color: rgba(24, 36, 58, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.context-meta-chip.is-accent {
    background-color: rgba(230, 189, 61, 0.13);
    border-left-color: rgba(230, 189, 61, 0.2);
    border-right-color: rgba(230, 189, 61, 0.2);
    border-top-color: rgba(230, 189, 61, 0.2);
    border-bottom-color: rgba(230, 189, 61, 0.2);
}

.context-meta-chip-label {
    font-size: 9px;
    color: rgba(226, 235, 246, 0.56);
    margin-bottom: 1px;
}

.context-meta-chip-value {
    font-size: 11px;
    color: rgb(248, 251, 255);
}

.context-highlights {
    flex-direction: column;
    gap: 6px;
    margin-bottom: 8px;
}

.context-highlight-card {
    width: 100%;
    min-width: 0;
    padding: 8px 10px;
    border-radius: 12px;
    background-color: rgba(24, 36, 58, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2px 8px;
}

.context-highlight-card.is-positive {
    background-color: rgba(91, 196, 255, 0.14);
    border-left-color: rgba(91, 196, 255, 0.22);
    border-right-color: rgba(91, 196, 255, 0.22);
    border-top-color: rgba(91, 196, 255, 0.22);
    border-bottom-color: rgba(91, 196, 255, 0.22);
}

.context-highlight-card.is-warning {
    background-color: rgba(230, 189, 61, 0.13);
    border-left-color: rgba(230, 189, 61, 0.2);
    border-right-color: rgba(230, 189, 61, 0.2);
    border-top-color: rgba(230, 189, 61, 0.2);
    border-bottom-color: rgba(230, 189, 61, 0.2);
}

.context-highlight-title {
    font-size: 10px;
    color: rgba(226, 235, 246, 0.58);
    margin-bottom: 0;
    max-width: 42%;
}

.context-highlight-value {
    font-size: 13px;
    color: rgb(248, 251, 255);
    margin-bottom: 0;
    flex-grow: 1;
    min-width: 0;
    -unity-text-align: upper-right;
}

.context-highlight-detail {
    width: 100%;
    margin-top: 2px;
    font-size: 10px;
    line-height: 13px;
    color: rgba(226, 235, 246, 0.74);
    white-space: normal;
}

.context-meta-chip.is-accent {
    background-color: rgba(230, 189, 61, 0.14);
    border-left-color: rgba(230, 189, 61, 0.22);
    border-right-color: rgba(230, 189, 61, 0.22);
    border-top-color: rgba(230, 189, 61, 0.22);
    border-bottom-color: rgba(230, 189, 61, 0.22);
}

.context-meta-chip-label {
    font-size: 10px;
    color: rgba(226, 235, 246, 0.6);
    margin-bottom: 1px;
}

.context-meta-chip-value {
    font-size: 12px;
    color: rgb(248, 251, 255);
}

.context-highlights {
    flex-direction: column;
    gap: 6px;
    margin-bottom: 8px;
}

.context-highlight-card {
    width: 100%;
    min-width: 0;
    padding: 8px;
    border-radius: 12px;
    background-color: rgba(24, 36, 58, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.context-highlight-card.is-positive {
    background-color: rgba(91, 196, 255, 0.16);
    border-left-color: rgba(91, 196, 255, 0.24);
    border-right-color: rgba(91, 196, 255, 0.24);
    border-top-color: rgba(91, 196, 255, 0.24);
    border-bottom-color: rgba(91, 196, 255, 0.24);
}

.context-highlight-card.is-warning {
    background-color: rgba(230, 189, 61, 0.14);
    border-left-color: rgba(230, 189, 61, 0.22);
    border-right-color: rgba(230, 189, 61, 0.22);
    border-top-color: rgba(230, 189, 61, 0.22);
    border-bottom-color: rgba(230, 189, 61, 0.22);
}

.attempts-list {
    margin-top: 2px;
    max-height: 180px;
    padding-top: 0;
}

.attempt-row {
    margin-top: 4px;
    margin-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(24, 36, 58, 0.92);
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.attempt-row-label {
    white-space: normal;
    font-size: 11px;
    line-height: 16px;
    color: rgba(244, 248, 255, 0.88);
}

.stats-mode-summary {
    margin-bottom: 6px;
    padding: 7px 9px;
    border-radius: 12px;
    background-color: rgba(91, 196, 255, 0.1);
    color: rgba(223, 244, 255, 0.92);
    font-size: 11px;
    display: flex;
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

.stat-tile {
    width: 48.5%;
    min-width: 0;
    min-height: 70px;
    padding: 9px;
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 100%), rgba(24, 36, 58, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    justify-content: space-between;
}

.stat-tile.is-accent {
    background: linear-gradient(180deg, rgba(91, 196, 255, 0.12) 0%, rgba(91, 196, 255, 0) 100%), rgba(24, 36, 58, 0.92);
    border-left-color: rgba(91, 196, 255, 0.22);
    border-right-color: rgba(91, 196, 255, 0.22);
    border-top-color: rgba(91, 196, 255, 0.22);
    border-bottom-color: rgba(91, 196, 255, 0.22);
}

.stat-tile-label {
    font-size: 11px;
    color: rgba(226, 235, 246, 0.64);
    white-space: normal;
}

.stat-tile-value {
    font-size: 19px;
    color: rgb(248, 251, 255);
    margin-top: 6px;
}

.goals-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-top: 2px;
}

.task-card {
    margin-bottom: 8px;
    padding: 10px;
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 100%), rgba(24, 36, 58, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.task-card.is-actionable {
    background: linear-gradient(180deg, rgba(91, 196, 255, 0.12) 0%, rgba(91, 196, 255, 0) 100%), rgba(24, 36, 58, 0.92);
    border-left-color: rgba(91, 196, 255, 0.26);
    border-right-color: rgba(91, 196, 255, 0.26);
    border-top-color: rgba(91, 196, 255, 0.26);
    border-bottom-color: rgba(91, 196, 255, 0.26);
}

.task-card.is-claimed {
    opacity: 0.82;
}

.task-card-toprow {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 6px;
}

.task-card-title {
    flex-grow: 1;
    min-width: 0;
    color: rgb(248, 251, 255);
    font-size: 14px;
    white-space: normal;
}

.task-card-tier {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 12px;
    background-color: rgba(230, 189, 61, 0.14);
    color: rgb(247, 224, 140);
    font-size: 10px;
    flex-shrink: 0;
}

.task-card-status {
    margin-bottom: 6px;
    color: rgba(226, 235, 246, 0.76);
    font-size: 11px;
}

.task-progress-track {
    height: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 8px;
}

.task-progress-fill {
    height: 100%;
    background-color: rgba(91, 196, 255, 0.95);
    border-radius: 12px;
}

.task-card-bottomrow {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.task-card-reward {
    color: rgb(241, 199, 74);
    font-size: 12px;
}

.task-action-button {
    min-width: 96px;
    min-height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    background-color: rgba(91, 196, 255, 0.95);
    color: rgb(14, 22, 34);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(220, 245, 255, 0.55);
    border-right-color: rgba(220, 245, 255, 0.55);
    border-top-color: rgba(220, 245, 255, 0.55);
    border-bottom-color: rgba(220, 245, 255, 0.55);
}

.task-action-button:disabled {
    background-color: rgba(91, 196, 255, 0.12);
    color: rgba(223, 244, 255, 0.55);
    border-left-color: rgba(91, 196, 255, 0.16);
    border-right-color: rgba(91, 196, 255, 0.16);
    border-top-color: rgba(91, 196, 255, 0.16);
    border-bottom-color: rgba(91, 196, 255, 0.16);
}

.achievement-category-row {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 6px;
    min-height: 38px;
    height: 38px;
    margin-bottom: 8px;
    align-items: stretch;
    justify-content: space-between;
}

.achievement-category-row.is-hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
}

.achievement-scroll {
    flex-grow: 1;
    min-height: 0;
}

.achievement-grid {
    flex-direction: column;
    flex-wrap: nowrap;
    width: 100%;
    min-width: 0;
}

.achievement-card {
    width: 100%;
    min-width: 0;
    min-height: 108px;
    height: auto;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 100%), rgba(24, 36, 58, 0.92);
    border-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    overflow: hidden;
}

.achievement-card.is-complete {
    background: linear-gradient(180deg, rgba(91, 196, 255, 0.12) 0%, rgba(91, 196, 255, 0) 100%), rgba(24, 36, 58, 0.92);
    border-left-color: rgba(91, 196, 255, 0.24);
    border-right-color: rgba(91, 196, 255, 0.24);
    border-top-color: rgba(91, 196, 255, 0.24);
    border-bottom-color: rgba(91, 196, 255, 0.24);
}

.achievement-card-toprow {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 6px;
}

.achievement-card-icon {
    width: 28px;
    min-width: 28px;
    height: 28px;
    margin-bottom: 0;
    padding-top: 2px;
    border-radius: 8px;
    background-color: rgba(230, 189, 61, 0.14);
    color: rgb(247, 224, 140);
    unity-text-align: middle-center;
    font-size: 15px;
}

.achievement-card-title {
    flex-grow: 1;
    min-width: 0;
    margin-bottom: 0;
    color: rgb(248, 251, 255);
    font-size: 13px;
    white-space: normal;
}

.achievement-card-state {
    min-width: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 12px;
    font-size: 10px;
    color: rgba(226, 235, 246, 0.84);
    background-color: rgba(255, 255, 255, 0.06);
    white-space: nowrap;
}

.achievement-card-state.is-complete {
    color: rgb(176, 229, 255);
    background-color: rgba(91, 196, 255, 0.12);
}

.achievement-card-description {
    min-width: 0;
    white-space: normal;
    font-size: 11px;
    color: rgba(244, 248, 255, 0.82);
    margin-bottom: 4px;
    max-height: 30px;
    overflow: hidden;
}

.achievement-card-requirement {
    min-width: 0;
    white-space: normal;
    font-size: 10px;
    color: rgba(226, 235, 246, 0.66);
    margin-bottom: 8px;
    max-height: 28px;
    overflow: hidden;
}

.achievement-progress-track {
    height: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 6px;
}

.achievement-progress-fill {
    height: 100%;
    background-color: rgba(91, 196, 255, 0.95);
    border-radius: 12px;
}

.achievement-card-progress {
    min-width: 0;
    font-size: 10px;
    color: rgba(226, 235, 246, 0.74);
}

.pass-current {
    margin-bottom: 8px;
    color: rgb(248, 251, 255);
}

.pass-levels-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
}

.pass-purchase-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    align-content: flex-start;
}

.pass-purchase-row {
    width: 94px;
    min-height: 74px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    gap: 6px;
    margin-bottom: 0;
    background-color: rgba(24, 36, 58, 0.92);
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.pass-quote-label {
    flex-grow: 1;
    font-size: 10px;
    white-space: normal;
    unity-text-align: upper-left;
    color: rgba(244, 248, 255, 0.88);
}

.pass-buy-button {
    min-width: 0;
    height: auto;
    background-color: rgba(91, 196, 255, 0.95);
    color: rgb(14, 22, 34);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(220, 245, 255, 0.55);
    border-right-color: rgba(220, 245, 255, 0.55);
    border-top-color: rgba(220, 245, 255, 0.55);
    border-bottom-color: rgba(220, 245, 255, 0.55);
}

.pass-expiry-meta {
    margin-top: 2px;
    margin-bottom: 8px;
    color: rgba(226, 235, 246, 0.78);
    -unity-text-align: upper-center;
    font-size: 12px;
}

.pass-expiry-bar {
    height: 10px;
    margin-bottom: 10px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
}

.pass-expiry-fill {
    height: 100%;
    width: 100%;
    border-radius: 12px;
    background-color: rgba(91, 196, 255, 0.95);
}

.map-layer-bar {
    position: absolute;
    left: 50%;
    top: 62px;
    translate: -50% 0;
    flex-direction: row;
    gap: 6px;
    background-color: rgba(10, 16, 28, 0.84);
    border-radius: 14px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.map-button {
    position: absolute;
    background-color: rgba(10, 16, 28, 0.84);
    color: rgba(244, 248, 255, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.3);
    border-right-color: rgba(91, 196, 255, 0.3);
    border-top-color: rgba(91, 196, 255, 0.3);
    border-bottom-color: rgba(91, 196, 255, 0.3);
}

.map-button-reset {
    right: 16px;
    bottom: 16px;
}

.map-button-center {
    right: 88px;
    bottom: 16px;
}

.is-hidden {
    display: none;
}

.map-host {
    position: absolute;
    top: 76px;
    bottom: 16px;
    left: 365px;
    right: 365px;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.map-legend-panel {
    position: absolute;
    right: 14px;
    top: auto;
    bottom: 14px;
    left: auto;
    width: 120px;
    max-width: 120px;
    max-height: 420px;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-radius: 14px;
    background-color: rgba(10, 16, 28, 0.86);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.map-legend-title {
    font-size: 11px;
    color: rgb(248, 251, 255);
    margin-bottom: 6px;
}

.map-legend-section-label {
    margin-top: 5px;
    margin-bottom: 4px;
    font-size: 9px;
    color: rgba(226, 235, 246, 0.74);
}

.map-legend-row {
    flex-direction: row;
    gap: 6px;
    margin-bottom: 4px;
}

.map-legend-wrap {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
}

.map-legend-chip {
    min-height: 22px;
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    border-radius: 12px;
    background-color: rgba(24, 36, 58, 0.92);
    opacity: 0.68;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.map-legend-chip.is-on {
    background-color: rgba(91, 196, 255, 0.16);
    opacity: 1;
    border-left-color: rgba(91, 196, 255, 0.24);
    border-right-color: rgba(91, 196, 255, 0.24);
    border-top-color: rgba(91, 196, 255, 0.24);
    border-bottom-color: rgba(91, 196, 255, 0.24);
}

.map-legend-chip:hover {
    background-color: rgba(91, 196, 255, 0.1);
}

.map-legend-chip.is-on:hover {
    background-color: rgba(91, 196, 255, 0.2);
}

.map-legend-chip-text {
    flex-grow: 1;
    min-width: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 9px;
    line-height: 11px;
    -unity-text-align: middle-left;
    color: rgba(226, 235, 246, 0.74);
}

.map-legend-chip.is-on .map-legend-chip-text {
    color: rgba(244, 248, 255, 0.96);
}

.map-legend-chip-dot {
    width: 8px;
    height: 8px;
    min-width: 8px;
    min-height: 8px;
    flex-shrink: 0;
    align-self: center;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: rgba(226, 235, 246, 0.52);
}

.map-legend-chip.is-on .map-legend-chip-dot {
    opacity: 1;
}

.legend-chip-run .map-legend-chip-dot {
    background-color: rgba(90, 200, 255, 0.95);
}

.legend-chip-lift .map-legend-chip-dot {
    background-color: rgba(255, 214, 10, 0.95);
}

.legend-chip-poi .map-legend-chip-dot {
    background-color: rgba(255, 255, 255, 0.95);
}

.legend-chip-resort .map-legend-chip-dot {
    background-color: rgba(64, 191, 255, 0.95);
}

.legend-chip-kiosk .map-legend-chip-dot {
    background-color: rgba(255, 191, 64, 0.95);
}

.legend-chip-shop .map-legend-chip-dot {
    background-color: rgba(255, 102, 166, 0.95);
}

.legend-chip-service .map-legend-chip-dot {
    background-color: rgba(96, 255, 128, 0.95);
}

.legend-chip-landmark .map-legend-chip-dot {
    background-color: rgba(204, 204, 255, 0.95);
}

.legend-chip-custom .map-legend-chip-dot {
    background-color: rgba(255, 255, 255, 0.8);
}

.is-difficulty-green .map-legend-chip-dot {
    background-color: rgba(65, 217, 65, 0.95);
}

.is-difficulty-blue .map-legend-chip-dot {
    background-color: rgba(64, 128, 255, 0.95);
}

.is-difficulty-red .map-legend-chip-dot {
    background-color: rgba(242, 77, 77, 0.95);
}

.is-difficulty-black .map-legend-chip-dot {
    background-color: rgba(230, 230, 230, 0.95);
}

.legend-chip-difficulty-green .map-legend-chip-dot {
    background-color: rgba(65, 217, 65, 0.95);
}

.legend-chip-difficulty-blue .map-legend-chip-dot {
    background-color: rgba(64, 128, 255, 0.95);
}

.legend-chip-difficulty-red .map-legend-chip-dot {
    background-color: rgba(242, 77, 77, 0.95);
}

.legend-chip-difficulty-black .map-legend-chip-dot {
    background-color: rgba(230, 230, 230, 0.95);
}

