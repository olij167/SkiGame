}

.map-legend-chip {
    min-height: 22px;
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    border-radius: 12px;
    background-color: rgba(24,36,58,0.92);
    opacity: 0.68;
    border-left-width: 1px;
    border-right-width: 1px;
