/* Selection tray collapse states.
   Visibility for ContextDetailRow, ContextMetaRow, and ContextHighlights is
   controlled from MountainHudOverlayController.ApplySelectionTraySectionVisibility().
   Avoid :not(...) selectors here because Unity USS does not support them. */
.map-selection-panel.has-only-context-identity {
    width: 560px;
    max-width: 560px;
}

.map-selection-panel.has-only-context-identity .selection-detail-row {
    display: none;
}

.overlay-action-stack {
    position: absolute;
    left: 16px;
    right: auto;
    bottom: 16px;
