.overlay-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(245, 245, 245);
    -unity-font-definition: resource('Inter-Regular');
}

.map-viewport {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.map-content {
    position: absolute;
    left: 0;
    top: 0;
    width: 1024px;
    height: 1024px;
}

.map-background {
    position: absolute;
    left: 0;
    top: 0;
    width: 1024px;
    height: 1024px;
}

.map-polylines {
    position: absolute;
    left: 0;
    top: 0;
    width: 1024px;
    height: 1024px;
}

.map-markers {
    position: absolute;
    left: 0;
    top: 0;
    width: 1024px;
    height: 1024px;
}

.panel {
    background-color: rgb(8, 12, 18);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.top-strip {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 42px;
}

.top-strip-time {
    font-size: 18px;
    -unity-font-style: bold;
    min-width: 80px;
}

.top-strip-weather {
    min-width: 150px;
}

.top-strip-location {
    flex-grow: 1;
    -unity-font-style: bold;
}

.top-strip-hint {
    color: rgba(255, 255, 255, 0.75);
}

.left-rail {
    position: absolute;
    left: 16px;
    top: 66px;
    bottom: 16px;
    width: 330px;
    gap: 12px;
}

.right-rail {
    position: absolute;
    right: 16px;
    top: 66px;
    bottom: 16px;
    width: 340px;
    gap: 12px;
}

.dock-panel {
    margin-bottom: 12px;
}

.context-panel {
    flex-grow: 1;
    min-height: 260px;
}

.stats-panel {
    min-height: 180px;
    overflow: hidden;
}

.goals-panel {
    flex-grow: 1;
    min-height: 300px;
}

.pass-panel {
    min-height: 220px;
    overflow: hidden;
}

.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.panel-title {
    font-size: 16px;
    -unity-font-style: bold;
}

.context-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.context-body {
    white-space: normal;
    line-height: 18px;
    color: rgba(255, 255, 255, 0.92);
}

.stats-body {
    white-space: normal;
    line-height: 18px;
    color: rgba(255, 255, 255, 0.92);
}

.attempts-list {
    margin-top: 8px;
    max-height: 220px;
}

.attempt-row {
    margin-top: 4px;
    margin-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 10px;
}

.attempt-row-label {
    white-space: normal;
    font-size: 11px;
}

.segmented-row {
    flex-direction: row;
    gap: 6px;
}

.segment-button {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.mini-button {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.pass-level-button {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.pass-buy-button {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.goal-subtab-button {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.map-layer-button {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.map-button {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.list-row {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.segment-button {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.95);
    min-height: 26px;
}

.goal-subtab-button {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.95);
    min-height: 26px;
}

.pass-level-button {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.95);
    min-height: 26px;
}

.mini-button {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.95);
    min-height: 26px;
}

.map-layer-button {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.95);
    min-height: 26px;
}

.segment-button.is-selected {
    background-color: rgba(255, 255, 255, 0.18);
}

.goal-subtab-button.is-selected {
    background-color: rgba(255, 255, 255, 0.18);
}

.pass-level-button.is-selected {
    background-color: rgba(255, 255, 255, 0.18);
}

.map-layer-button.is-selected {
    background-color: rgba(255, 255, 255, 0.18);
}

.goals-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.list-row {
    margin-bottom: 6px;
    min-height: 44px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    color: white;
    justify-content: space-between;
    align-items: center;
}

.list-row.is-actionable {
    background-color: rgba(43, 119, 214, 0.35);
}

.list-row-title {
    flex-grow: 1;
    -unity-font-style: bold;
    white-space: normal;
}

.list-row-value {
    color: rgba(255, 255, 255, 0.85);
    margin-left: 8px;
}

.achievement-category-row {
    display: none;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
}

.achievement-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: flex-start;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
}


.achievement-card {
    width: 48.5%;
    min-width: 0;
    height: 196px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: flex-start;
    overflow: hidden;
}

.achievement-card-icon {
    font-size: 22px;
    margin-bottom: 6px;
}

.achievement-card-title {
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 6px;
}

.achievement-card-state {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.72);
    white-space: normal;
}

.achievement-card-state.is-complete {
    color: rgb(180, 235, 180);
}

.achievement-empty-state {
    width: 100%;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
    white-space: normal;
    color: rgba(255, 255, 255, 0.72);
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 12px;
}

.achievement-card.is-complete {
    background-color: rgba(86, 150, 104, 0.18);
    border-left-color: rgba(180, 235, 180, 0.22);
    border-right-color: rgba(180, 235, 180, 0.22);
    border-top-color: rgba(180, 235, 180, 0.22);
    border-bottom-color: rgba(180, 235, 180, 0.22);
}

.achievement-card-toprow {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.achievement-card-description {
    white-space: normal;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 6px;
    max-height: 32px;
    overflow: hidden;
}

.achievement-card-requirement {
    white-space: normal;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 8px;
    max-height: 32px;
    overflow: hidden;
}

.achievement-progress-track {
    height: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
    margin-top: auto;
    margin-bottom: 6px;
}

.achievement-progress-fill {
    height: 100%;
    background-color: rgba(83, 170, 255, 0.9);
    border-radius: 999px;
}

.achievement-card-progress {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.78);
}

.achievement-card-title,
.achievement-card-description,
.achievement-card-requirement,
.achievement-card-progress,
.achievement-card-state {
    min-width: 0;
}

.pass-current {
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.pass-levels-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
}

.pass-purchase-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    align-content: flex-start;
}

.pass-purchase-row {
    width: 94px;
    min-height: 74px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    gap: 6px;
    margin-bottom: 0;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.pass-quote-label {
    flex-grow: 1;
    font-size: 10px;
    white-space: normal;
    unity-text-align: upper-left;
}

.pass-buy-button {
    min-width: 0;
    height: auto;
    background-color: rgba(43, 119, 214, 0.35);
    color: white;
}

.map-layer-bar {
    position: absolute;
    left: 50%;
    top: 62px;
    translate: -50% 0;
    flex-direction: row;
    gap: 6px;
    background-color: rgba(8, 12, 18, 0.72);
    border-radius: 14px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.map-button {
    position: absolute;
    background-color: rgba(8, 12, 18, 0.72);
    color: rgba(255, 255, 255, 0.95);
}

.map-button-reset {
    right: 16px;
    bottom: 16px;
}

.map-button-center {
    right: 88px;
    bottom: 16px;
}

.is-hidden {
    display: none;
}

.map-host {
    position: absolute;
    top: 76px;
    bottom: 16px;
    left: 360px;
    right: 370px;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.context-meta-row {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
}

.context-meta-chip {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.08);
}

.context-meta-chip.is-accent {
    background-color: rgba(83, 170, 255, 0.22);
}

.context-meta-chip-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.68);
}

.context-meta-chip-value {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.96);
}

.context-highlights {
    margin-top: 8px;
    gap: 6px;
}

.context-highlight-card {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.context-highlight-title {
    -unity-font-style: bold;
    margin-bottom: 2px;
    white-space: normal;
}

.context-highlight-value {
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 2px;
}

.context-highlight-detail {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.68);
    white-space: normal;
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
    align-content: flex-start;
}

.stat-tile {
    width: 48%;
    min-height: auto;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    height: auto;
}

.stat-tile.is-accent {
    background-color: rgba(83, 170, 255, 0.12);
    border-left-color: rgba(83, 170, 255, 0.28);
    border-right-color: rgba(83, 170, 255, 0.28);
    border-top-color: rgba(83, 170, 255, 0.28);
    border-bottom-color: rgba(83, 170, 255, 0.28);
}

.stat-tile-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.68);
    margin-bottom: 0;
    white-space: normal;
}

.stat-tile-value {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.98);
}

.task-card {
    margin-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
}

.task-card.is-actionable {
    background-color: rgba(43, 119, 214, 0.2);
    border-left-color: rgba(83, 170, 255, 0.32);
    border-right-color: rgba(83, 170, 255, 0.32);
    border-top-color: rgba(83, 170, 255, 0.32);
    border-bottom-color: rgba(83, 170, 255, 0.32);
}

.task-card.is-claimed {
    background-color: rgba(86, 150, 104, 0.14);
}

.task-card-toprow {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 6px;
}

.task-card-title {
    flex-grow: 1;
    -unity-font-style: bold;
    white-space: normal;
}

.task-card-tier {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.68);
}

.task-card-status {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 6px;
    white-space: normal;
}

.task-card-bottomrow {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
}

.task-card-reward {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.78);
}

.task-progress-track {
    height: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
}

.task-progress-fill {
    height: 100%;
    background-color: rgba(83, 170, 255, 0.9);
    border-radius: 999px;
}

.task-action-button {
    min-width: 84px;
    background-color: rgba(83, 170, 255, 0.22);
    color: rgba(255, 255, 255, 0.96);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.stats-mode-summary {
    margin-top: 2px;
    margin-bottom: 6px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.68);
}

.achievement-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

.achievement-scroll > .unity-scroll-view__content-container {
    flex-direction: column;
    align-content: stretch;
    min-width: 0;
}

.goals-panel {
    flex-grow: 1;
    min-height: 300px;
}

.attempts-list {
    margin-top: 8px;
    max-height: 220px;
    flex-shrink: 0;
}
