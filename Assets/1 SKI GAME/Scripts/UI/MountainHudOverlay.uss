    padding-bottom: 10px;

    border-radius: 16px;
    background-color: rgba(8, 12, 18, 0.82);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgba(255,255,255,0.08);
    border-right-color: rgba(255,255,255,0.08);
    border-top-color: rgba(255,255,255,0.08);
    border-bottom-color: rgba(255,255,255,0.08);
}

.map-legend-title {
    font-size: 12px;
    unity-font-style: bold;
    color: rgba(255,255,255,0.96);
    margin-bottom: 8px;
}

.map-legend-section-label {
    margin-top: 6px;
    margin-bottom: 5px;
    font-size: 10px;
    unity-font-style: bold;
    color: rgba(255,255,255,0.72);
}

.map-legend-row {
    flex-direction: row;
    gap: 6px;
    margin-bottom: 4px;
}

.map-legend-wrap {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
}

.map-legend-chip {
    min-height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;

    flex-direction: row;
    align-items: center;
    gap: 6px;

    border-radius: 999px;
    background-color: rgba(255,255,255,0.08);
}

.map-legend-chip.is-on {
    background-color: rgba(255,255,255,0.18);
}

.map-legend-chip-compact {
    min-width: 0;
}

.map-legend-chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: rgba(255,255,255,0.34);
}

.map-legend-chip.is-on .map-legend-chip-dot {
    background-color: rgba(255,255,255,0.92);
}

.map-legend-chip-text {
    font-size: 10px;
    unity-font-style: bold;
    color: rgba(255,255,255,0.88);
}

.legend-chip-run .map-legend-chip-dot { background-color: rgba(90,200,255,0.95); }
.legend-chip-lift .map-legend-chip-dot { background-color: rgba(255,214,10,0.95); }
.legend-chip-poi .map-legend-chip-dot { background-color: rgba(255,255,255,0.95); }

.legend-chip-resort .map-legend-chip-dot { background-color: rgba(64,191,255,0.95); }
.legend-chip-kiosk .map-legend-chip-dot { background-color: rgba(255,191,64,0.95); }
.legend-chip-shop .map-legend-chip-dot { background-color: rgba(255,102,166,0.95); }
.legend-chip-service .map-legend-chip-dot { background-color: rgba(96,255,128,0.95); }
.legend-chip-landmark .map-legend-chip-dot { background-color: rgba(204,204,255,0.95); }
.legend-chip-custom .map-legend-chip-dot { background-color: rgba(255,255,255,0.80); }

.is-difficulty-green .map-legend-chip-dot { background-color: rgba(65,217,65,0.95); }
.is-difficulty-blue .map-legend-chip-dot { background-color: rgba(64,128,255,0.95); }
.is-difficulty-red .map-legend-chip-dot { background-color: rgba(242,77,77,0.95); }
.is-difficulty-black .map-legend-chip-dot { background-color: rgba(230,230,230,0.95); }

.context-meta-row {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
}

.context-meta-chip {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.08);
}

.context-meta-chip.is-accent {
    background-color: rgba(83, 170, 255, 0.22);
}

.context-meta-chip-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.68);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.context-meta-chip-value {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.96);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.context-highlights {
    margin-top: 8px;
    gap: 6px;
}

.context-highlight-card {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.context-highlight-title {
    -unity-font-style: bold;
    margin-bottom: 2px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.context-highlight-value {
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 2px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.context-highlight-detail {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.68);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
    align-content: flex-start;
}

.stat-tile {
    width: 48%;
    min-height: auto;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    height: auto;
}

.stat-tile.is-accent {
    background-color: rgba(83, 170, 255, 0.12);
    border-left-color: rgba(83, 170, 255, 0.28);
    border-right-color: rgba(83, 170, 255, 0.28);
    border-top-color: rgba(83, 170, 255, 0.28);
    border-bottom-color: rgba(83, 170, 255, 0.28);
}

.stat-tile-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.68);
    margin-bottom: 0;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.stat-tile-value {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.98);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.task-card {
    margin-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
}

.task-card.is-actionable {
    background-color: rgba(43, 119, 214, 0.2);
    border-left-color: rgba(83, 170, 255, 0.32);
    border-right-color: rgba(83, 170, 255, 0.32);
    border-top-color: rgba(83, 170, 255, 0.32);
    border-bottom-color: rgba(83, 170, 255, 0.32);
}

.task-card.is-claimed {
    background-color: rgba(86, 150, 104, 0.14);
}

.task-card-toprow {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 6px;
}

.task-card-title {
    flex-grow: 1;
    -unity-font-style: bold;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.task-card-tier {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.68);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.task-card-status {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 6px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.task-card-bottomrow {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
}

.task-card-reward {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.78);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.task-progress-track {
    height: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
}

.task-progress-fill {
    height: 100%;
    background-color: rgba(83, 170, 255, 0.9);
    border-radius: 999px;
}

.task-action-button {
    min-width: 84px;
    background-color: rgba(83, 170, 255, 0.22);
    color: rgba(255, 255, 255, 0.96);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.stats-mode-summary {
    margin-top: 2px;
    margin-bottom: 6px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.68);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.achievement-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

.achievement-scroll > .unity-scroll-view__content-container {
    flex-direction: column;
    align-content: stretch;
    min-width: 0;
}

.goals-panel {
    flex-grow: 1;
    min-height: 300px;
}

.attempts-list {
    margin-top: 8px;
    max-height: 220px;
    flex-shrink: 0;
}

.top-weather-group {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    min-width: 150px;
}

.top-strip-weather-icon {
    width: 24px;
    min-width: 24px;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.95);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.top-strip-weather {
    min-width: 0;
    flex-shrink: 1;
    white-space: normal;
}

.context-hero {
    flex-direction: row;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 10px;
}

.context-icon {
    width: 40px;
    min-width: 40px;
    height: 40px;
    padding-top: 7px;
    border-radius: 12px;
    background-color: rgba(83, 170, 255, 0.16);
    -unity-text-align: upper-center;
    font-size: 20px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.context-hero-copy {
    flex-grow: 1;
    min-width: 0;
}

.context-title-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 4px;
}

.context-status-pill {
    flex-shrink: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 999px;
    background-color: rgba(83, 170, 255, 0.18);
    color: rgba(255, 255, 255, 0.96);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.context-guidance-box {
    margin-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.context-guidance {
    white-space: normal;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.78);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.context-highlight-card.is-positive {
    background-color: rgba(86, 150, 104, 0.14);
    border-left-color: rgba(180, 235, 180, 0.18);
    border-right-color: rgba(180, 235, 180, 0.18);
    border-top-color: rgba(180, 235, 180, 0.18);
    border-bottom-color: rgba(180, 235, 180, 0.18);
}

.context-highlight-card.is-warning {
    background-color: rgba(214, 146, 43, 0.14);
    border-left-color: rgba(255, 211, 138, 0.18);
    border-right-color: rgba(255, 211, 138, 0.18);
    border-top-color: rgba(255, 211, 138, 0.18);
    border-bottom-color: rgba(255, 211, 138, 0.18);
}
