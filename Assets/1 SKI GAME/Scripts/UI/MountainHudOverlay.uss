.modal-scrim {
    z-index: 40;
}

.overlay-screen-fade {
    z-index: 60;
}

/* ==========================================================================
   Map Selection Panel — layout containment + responsive sizing pass
   Keeps selected map details inside the tray without text/card overflow.
   ========================================================================== */

.map-selection-panel {
    position: absolute;
    top: 100px;
    left: 50%;
    right: auto;
    bottom: auto;
    translate: -50% 0;

    width: 760px;
    max-width: 82%;
    min-width: 0;

    max-height: 380px;
    min-height: 0;

    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;

    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;

    overflow: hidden;
    flex-grow: 0;
    flex-shrink: 1;

    z-index: 9;
}

.map-selection-panel.has-only-context-identity {
    width: 560px;
    max-width: 70%;
    min-width: 0;
}

.selection-main-row {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;

    width: 100%;
    min-width: 0;
    min-height: 0;

    margin-bottom: 8px;
    overflow: hidden;

    flex-grow: 0;
    flex-shrink: 0;
}

.selection-identity-block {
    flex-direction: row;
    align-items: stretch;

    width: 100%;
    min-width: 0;
    max-width: none;

    margin-bottom: 0;
    padding: 8px;

    border-radius: 12px;
    background-color: rgba(24, 36, 58, 0.9);

    overflow: hidden;

    flex-grow: 1;
    flex-shrink: 1;
}

.selection-identity-block .context-icon {
    width: 48px;
    min-width: 48px;
    max-width: 48px;

    height: 48px;
    min-height: 48px;
    max-height: 48px;

    margin-right: 8px;
    padding-top: 0;
    padding-bottom: 0;

    border-radius: 10px;

    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);

    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;

    white-space: normal;
    overflow: hidden;

    flex-grow: 0;
    flex-shrink: 0;
}

.selection-identity-block .context-hero-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    max-width: none;

    overflow: hidden;
}

.selection-identity-block .context-title-row {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;

    width: 100%;
    min-width: 0;

    gap: 8px;
    margin-bottom: 4px;

    overflow: hidden;
}

.selection-identity-block .context-title {
    flex-grow: 1;
    flex-shrink: 1;

    min-width: 0;
    max-width: none;

    font-size: 15px;
    line-height: 18px;

    margin-bottom: 0;

    color: rgb(248, 251, 255);

    white-space: normal;
    overflow: hidden;
}

.selection-identity-block .context-status-pill {
    flex-grow: 0;
    flex-shrink: 1;

    min-width: 0;
    max-width: 150px;
    min-height: 20px;

    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;

