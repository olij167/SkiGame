}

.quest-card.is-tracked {
    background: linear-gradient(180deg, rgba(132, 214, 255, 0.12) 0%, rgba(255, 255, 255, 0) 100%), rgba(20, 31, 50, 0.98);
    border-left-color: rgba(132, 214, 255, 0.34);
