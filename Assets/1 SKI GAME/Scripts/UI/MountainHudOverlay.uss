.achievement-card-header {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
}

.achievement-card-titleblock {
    flex-grow: 1;
    min-width: 0;
}

.achievement-card-subtitle {
    margin-top: 2px;
    font-size: 10px;
    color: rgba(226, 235, 246, 0.72);
    white-space: normal;
}

.achievement-card-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
}

.achievement-card-category {
