.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 24px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(10, 14, 20);
}

.shell {
    width: 1180px;
    max-width: 96%;
    height: 720px;
    max-height: 94%;
    align-items: center;
    justify-content: center;
}

.screen {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.home-screen {
    justify-content: center;
}

.hero-card {
    width: 520px;
    max-width: 92%;
    padding: 28px;
    border-radius: 18px;
    background-color: rgba(18, 26, 36, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    align-items: center;
    flex-grow: 0;
}

.hero-title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(240, 248, 255);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.hero-subtitle {
    font-size: 16px;
    color: rgba(230, 238, 247, 0.86);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 22px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.hero-actions {
    width: 100%;
    gap: 12px;
    margin-bottom: 16px;
}

.hero-footnote {
    font-size: 12px;
    color: rgba(215, 225, 236, 0.58);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.page-card {
    width: 100%;
    height: 100%;
    padding: 22px;
    border-radius: 18px;
    background-color: rgba(18, 26, 36, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.page-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.page-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(240, 248, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.content-row {
    flex-grow: 1;
    flex-direction: row;
    gap: 18px;
}

.slot-column {
    width: 380px;
    min-width: 340px;
    gap: 12px;
}

.slot-button {
    min-height: 96px;
    padding: 0;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    color: rgb(240, 248, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.slot-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.slot-button.slot-selected {
    background-color: rgba(125, 179, 255, 0.16);
    border-color: rgba(145, 195, 255, 0.65);
}

.slot-content {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: flex-start;
    padding: 16px;
}

.slot-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(245, 250, 255);
    margin-bottom: 4px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.slot-sub {
    font-size: 13px;
    color: rgba(225, 233, 243, 0.72);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.preview-column {
    flex-grow: 1;
    padding: 20px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.preview-heading {
    font-size: 14px;
    color: rgba(210, 220, 232, 0.64);
    margin-bottom: 6px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.preview-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(245, 250, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.preview-subtitle {
    font-size: 14px;
    color: rgba(225, 233, 243, 0.72);
    margin-bottom: 10px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.preview-divider {
    height: 1px;
    margin-top: 10px;
    margin-bottom: 14px;
    background-color: rgba(255, 255, 255, 0.08);
}

.kv-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
}

.kv-key {
    width: 140px;
    font-size: 14px;
    color: rgba(210, 220, 232, 0.72);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.kv-value {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(245, 250, 255);
    -unity-text-align: upper-right;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.preview-spacer {
    flex-grow: 1;
}

.preview-actions {
    gap: 10px;
}

.settings-scroll {
    flex-grow: 1;
}

.settings-group {
    margin-bottom: 16px;
    padding: 16px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.group-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(245, 250, 255);
    margin-bottom: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.setting-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
}

.setting-label {
    width: 170px;
    font-size: 14px;
    color: rgba(225, 233, 243, 0.82);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.setting-slider {
    flex-grow: 1;
}

.setting-dropdown {
    flex-grow: 1;
}

.setting-value {
    width: 70px;
    font-size: 13px;
    color: rgb(245, 250, 255);
    -unity-text-align: upper-right;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.setting-toggle {
    flex-grow: 1;
    align-items: flex-end;
}

.settings-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.menu-button {
    height: 46px;
    border-radius: 12px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 248, 255);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.menu-button:active {
    background-color: rgba(255, 255, 255, 0.16);
}

.menu-button-primary {
    background-color: rgba(95, 155, 255, 0.3);
    border-color: rgba(140, 190, 255, 0.72);
}

.menu-button-primary:hover {
    background-color: rgba(95, 155, 255, 0.42);
}

.menu-button-danger {
    background-color: rgba(150, 50, 50, 0.28);
    border-color: rgba(220, 120, 120, 0.6);
}

.menu-button-danger:hover {
    background-color: rgba(170, 60, 60, 0.38);
}

.small-button {
    min-width: 120px;
    height: 40px;
    border-radius: 10px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 248, 255);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.small-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

.modal-card {
    width: 420px;
    max-width: 92%;
    padding: 20px;
    border-radius: 16px;
    background-color: rgb(20, 28, 38);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.modal-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(245, 250, 255);
    margin-bottom: 8px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.modal-body {
    font-size: 14px;
    color: rgba(225, 233, 243, 0.78);
    margin-bottom: 16px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.modal-actions {
    gap: 10px;
}

.controls-toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
}

.controls-status {
    flex-grow: 1;
    font-size: 13px;
    color: rgba(225, 233, 243, 0.82);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.controls-note {
    font-size: 12px;
    color: rgba(215, 225, 236, 0.62);
    margin-bottom: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.controls-rebind-list {
    gap: 10px;
    padding-top: 2px;
    padding-bottom: 6px;
}

.controls-rebind-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 8px;
}

.controls-rebind-row.is-listening {
    background-color: rgba(95, 155, 255, 0.16);
    border-color: rgba(140, 190, 255, 0.72);
}

.controls-rebind-action {
    width: 220px;
    font-size: 14px;
    color: rgb(245, 250, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.controls-rebind-binding {
    flex-grow: 1;
    font-size: 14px;
    color: rgba(225, 233, 243, 0.82);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.controls-rebind-binding.is-listening {
    color: rgb(245, 250, 255);
}

.controls-rebind-btn {
    min-width: 110px;
    height: 40px;
    border-radius: 10px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 248, 255);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.controls-rebind-btn:hover {
    background-color: rgba(255, 255, 255, 0.12);
}