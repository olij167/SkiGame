.world-prompt-panel {
    position: absolute;
    left: 50%;
    bottom: 108px;
    translate: -50% 0;
    min-width: 320px;
    max-width: 560px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    gap: 6px;
    align-items: center;
    background-color: rgba(10, 16, 28, 0.94);
    color: rgb(244, 248, 255);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.world-prompt-action {
    font-size: 18px;
    color: rgb(248, 251, 255);
}

.world-prompt-action.input-prompt {
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
    gap: 12px;
}

.world-prompt-action .input-prompt-text,
.world-prompt-action .input-prompt-separator {
    color: rgb(248, 251, 255);
    font-size: 24px;
    line-height: 28px;
    -unity-font-style: bold;
    -unity-text-outline-color: rgba(6, 10, 18, 1);
    -unity-text-outline-width: 1px;
}

.world-prompt-action .input-prompt-icon {
    width: 68px;
    height: 68px;
}

.world-prompt-description {
    color: rgba(236, 243, 251, 0.96);
    font-size: 18px;
    line-height: 22px;
    unity-text-align: middle-center;
    -unity-text-outline-color: rgba(6, 10, 18, 1);
    -unity-text-outline-width: 1px;
}