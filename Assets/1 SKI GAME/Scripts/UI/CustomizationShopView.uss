.shop-root {
    flex-direction: column;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.35);
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.shop-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.shop-title {
    font-size: 18px;
    unity-font-style: bold;
    color: white;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.shop-header-right {
    flex-direction: row;
    align-items: center;
}

.shop-currency {
    margin-right: 10px;
    color: white;
    unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.shop-exit {
    padding-left: 10px;
    padding-right: 10px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.shop-body {
    flex-direction: row;
    height: 100%;
}

.shop-panel {
    width: 320px;
    padding: 10px;
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 10px;
    flex-shrink: 0;
    flex-direction: column;
}

.shop-content-column {
    flex-direction: column;
}

.preview-panel {
    flex-grow: 1;
    margin-right: 10px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 10px;
}

.preview-hint {
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.loadout-panel {
    width: 260px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 10px;
    flex-shrink: 0;
    flex-direction: column;
}

.panel-title {
    unity-font-style: bold;
    margin-bottom: 8px;
    color: white;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.panel-title.small {
    margin-top: 8px;
    font-size: 12px;
}

.tabs-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.tabs-row.sub {
    margin-bottom: 10px;
}

.tab-btn {
    flex-grow: 0;
    margin-right: 6px;
    background-color: rgb(53, 53, 53);
    color: white;
    text-overflow: clip;
    flex-direction: column;
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.tab-btn.is-active {
    background-color: rgba(255, 255, 255, 0.2);
    unity-font-style: bold;
}

.tab-btn.is-disabled {
    opacity: 0.35;
}

.options-list {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
}

.detail-panel {
    flex-grow: 1;
    padding: 10px;
    margin-top: 8px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
}

.detail-header {
    flex-direction: row;
    margin-bottom: 8px;
}

.detail-icon {
    width: 56px;
    height: 56px;
    margin-right: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

.detail-header-text {
    flex-grow: 1;
}

.detail-name {
    color: white;
    margin-top: 4px;
    unity-font-style: bold;
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.detail-desc {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.detail-meta {
    margin-top: 6px;
    margin-bottom: 8px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.detail-meta-line {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.detail-actions {
    flex-direction: row;
    margin-top: 10px;
}

.action-btn {
    flex-grow: 1;
    margin-right: 8px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.action-btn.primary {
    unity-font-style: bold;
}

.is-hidden {
    display: none;
}

.option-row {
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 6px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.12);
}

.option-row:hover {
    background-color: rgba(0, 0, 0, 0.18);
}

.option-icon {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-and-crop;
}

.option-mid {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.option-name {
    color: white;
    font-size: 12px;
    margin-top: 0;
    margin-bottom: 0;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.option-meta {
    color: rgba(255, 255, 255, 0.6);
    font-size: 10px;
    margin-top: 1px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.option-right {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.option-price {
    color: rgba(255, 255, 255, 0.85);
    unity-font-style: bold;
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.option-badge {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 999px;
    font-size: 10px;
    unity-font-style: bold;
    color: rgba(255, 255, 255, 0.9);
    background-color: rgba(255, 255, 255, 0.07);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.option-badge.is-equipped {
    background-color: rgba(0, 255, 160, 0.16);
}

.option-badge.is-owned {
    background-color: rgba(255, 255, 255, 0.09);
}

.option-badge.is-preview {
    background-color: rgba(255, 210, 80, 0.14);
}

.color-swatch {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgb(255, 255, 255);
}

.color-swatch.large {
    width: 100%;
    height: 22px;
    border-radius: 8px;
    margin-top: 6px;
}

.loadout-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    -unity-background-scale-mode: scale-and-crop;
}

.loadout-row-btn {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 10px;
    margin-top: 8px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.loadout-row-btn:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.loadout-text {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.loadout-title {
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.loadout-sub {
    color: rgba(255, 255, 255, 0.6);
    font-size: 10px;
    margin-top: 1px;
    -unity-text-align: lower-left;
    white-space: normal;
    text-overflow: ellipsis;
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.loadout-chevron {
    color: rgba(255, 255, 255, 0.35);
    margin-left: 6px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.loadout-gear-row {
    flex-direction: row;
    align-items: stretch;
    gap: 10px;
    margin-top: 10px;
    padding: 10px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
}

.loadout-slot {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    border-radius: 12px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    position: relative;
    justify-content: center;
}

.loadout-colour {
    width: 110px;
    min-width: 110px;
    flex-shrink: 0;
    border-radius: 12px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
}

.loadout-pattern {
    width: 120px;
    min-width: 120px;
    flex-shrink: 0;
    border-radius: 12px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    flex-direction: column;
}

.slot-title {
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.slot-title.small {
    font-size: 10px;
    opacity: 0.85;
}

.slot-sub {
    color: rgba(255, 255, 255, 0.6);
    font-size: 10px;
    margin-top: 2px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.pattern-thumb {
    width: 56px;
    height: 28px;
    border-radius: 8px;
    margin-top: 0;
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 1;
    flex-grow: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding: 0;
}

.loadout-badge {
    position: relative;
    top: auto;
    right: auto;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 6px;
    font-size: 10px;
    unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
    background-color: rgba(255, 255, 255, 0.07);
    flex-direction: column;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    margin-right: 0;
    left: auto;
    flex-grow: 0;
    -unity-text-align: lower-center;
    flex-shrink: 0;
    align-items: flex-start;
    align-self: flex-start;
    justify-content: flex-start;
    display: flex;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.loadout-badge.is-equipped {
    background-color: rgba(0, 255, 160, 0.14);
}

.loadout-badge.is-preview {
    background-color: rgba(255, 210, 80, 0.14);
    position: absolute;
}

.color-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    justify-content: center;
    align-items: center;
}

.color-popover {
    width: 320px;
    padding: 12px;
    background-color: rgba(15, 15, 15, 0.95);
    border-radius: 12px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.color-popover-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.color-preview {
    height: 46px;
    border-radius: 10px;
    margin-bottom: 10px;
}

.hsv-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.hsv-label {
    width: 18px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 11px;
    unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.color-slider {
    flex-grow: 1;
}

.color-presets {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
}

.color-preset-swatch {
    width: 28px;
    height: 28px;
    border-radius: 8px;
}

.loadout-top-row {
    flex-direction: row;
    align-items: stretch;
    gap: 10px;
    margin-top: 6px;
}