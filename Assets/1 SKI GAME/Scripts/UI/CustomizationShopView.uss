.shop-root {
    flex-direction: column;
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(6, 10, 18, 0.62);
    color: rgb(244, 248, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.shop-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.shop-title {
    font-size: 24px;
    color: rgb(248, 251, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.shop-header-right {
    flex-direction: row;
    align-items: center;
}

.shop-currency {
    margin-right: 10px;
    color: rgb(248, 251, 255);
    font-size: 14px;
}

.shop-exit {
    min-height: 40px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.36);
    border-right-color: rgba(91, 196, 255, 0.36);
    border-top-color: rgba(91, 196, 255, 0.36);
    border-bottom-color: rgba(91, 196, 255, 0.36);
}

.shop-body {
    flex-direction: row;
    height: 100%;
}

.shop-panel {
    width: 320px;
    padding: 10px;
    margin-right: 10px;
    background-color: rgba(10, 16, 28, 0.95);
    border-radius: 16px;
    flex-shrink: 0;
    flex-direction: column;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.shop-content-column {
    flex-direction: column;
}

.preview-panel {
    flex-grow: 1;
    margin-right: 10px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(14, 22, 36, 0.92);
    border-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.preview-hint {
    margin-bottom: 10px;
    color: rgba(226, 235, 246, 0.66);
    font-size: 11px;
}

.loadout-panel {
    width: 30%;
    min-width: 300px;
    max-width: 420px;
    padding: 10px;
    background-color: rgba(16, 24, 40, 0.94);
    border-radius: 16px;
    flex-shrink: 1;
    flex-direction: column;
    align-items: stretch;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.panel-title {
    margin-bottom: 8px;
    color: rgb(248, 251, 255);
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
}

.panel-title.small {
    margin-top: 8px;
    font-size: 12px;
}

.tabs-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.tabs-row.sub {
    margin-bottom: 10px;
}

.tab-btn {
    flex-grow: 0;
    margin-right: 6px;
    min-height: 38px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);
    text-overflow: clip;
    flex-direction: column;
    font-size: 12px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.3);
    border-right-color: rgba(91, 196, 255, 0.3);
    border-top-color: rgba(91, 196, 255, 0.3);
    border-bottom-color: rgba(91, 196, 255, 0.3);
}

.tab-btn.is-active {
    background-color: rgba(230, 189, 61, 0.95);
    color: rgb(18, 24, 34);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 239, 179, 0.55);
    border-right-color: rgba(255, 239, 179, 0.55);
    border-top-color: rgba(255, 239, 179, 0.55);
    border-bottom-color: rgba(255, 239, 179, 0.55);
}

.tab-btn.is-disabled {
    opacity: 0.35;
}

.options-list {
    background-color: rgba(24, 36, 58, 0.92);
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.detail-panel {
    flex-grow: 1;
    padding: 10px;
    margin-top: 8px;
    background-color: rgba(24, 36, 58, 0.92);
    border-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.detail-header {
    flex-direction: row;
    margin-bottom: 8px;
}

.detail-icon {
    width: 56px;
    height: 56px;
    margin-right: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

.detail-header-text {
    flex-grow: 1;
}

.detail-name {
    color: rgb(248, 251, 255);
    margin-top: 4px;
    font-size: 15px;
}

.detail-desc {
    color: rgba(244, 248, 255, 0.88);
    font-size: 12px;
}

.detail-meta {
    margin-top: 6px;
    margin-bottom: 8px;
}

.detail-meta-line {
    color: rgba(226, 235, 246, 0.78);
    font-size: 12px;
}

.detail-actions {
    flex-direction: row;
    margin-top: 10px;
}

.action-btn {
    flex-grow: 1;
    margin-right: 8px;
    min-height: 40px;
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.3);
    border-right-color: rgba(91, 196, 255, 0.3);
    border-top-color: rgba(91, 196, 255, 0.3);
    border-bottom-color: rgba(91, 196, 255, 0.3);
}

.action-btn.primary {
    background-color: rgba(91, 196, 255, 0.95);
    color: rgb(14, 22, 34);
    border-left-color: rgba(220, 245, 255, 0.55);
    border-right-color: rgba(220, 245, 255, 0.55);
    border-top-color: rgba(220, 245, 255, 0.55);
    border-bottom-color: rgba(220, 245, 255, 0.55);
}

.is-hidden {
    display: none;
}

.option-row {
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 6px;
    border-radius: 10px;
    background-color: rgba(24, 36, 58, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.option-row:hover {
    background-color: rgba(91, 196, 255, 0.1);
}

.option-icon {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-and-crop;
}

.option-mid {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.option-name {
    color: rgb(248, 251, 255);
    font-size: 12px;
    margin-top: 0;
    margin-bottom: 0;
}

.option-meta {
    color: rgba(226, 235, 246, 0.6);
    font-size: 10px;
    margin-top: 1px;
}

.option-right {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.option-price {
    color: rgba(244, 248, 255, 0.88);
    font-size: 12px;
}

.option-badge {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 999px;
    font-size: 10px;
    color: rgba(244, 248, 255, 0.92);
    background-color: rgba(91, 196, 255, 0.14);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.24);
    border-right-color: rgba(91, 196, 255, 0.24);
    border-top-color: rgba(91, 196, 255, 0.24);
    border-bottom-color: rgba(91, 196, 255, 0.24);
}

.option-badge.is-equipped {
    background-color: rgba(91, 196, 255, 0.16);
}

.option-badge.is-owned {
    background-color: rgba(255, 255, 255, 0.08);
}

.option-badge.is-preview {
    background-color: rgba(230, 189, 61, 0.16);
    color: rgb(247, 224, 140);
    border-left-color: rgba(230, 189, 61, 0.24);
    border-right-color: rgba(230, 189, 61, 0.24);
    border-top-color: rgba(230, 189, 61, 0.24);
    border-bottom-color: rgba(230, 189, 61, 0.24);
}

.color-swatch {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgb(255, 255, 255);
}

.color-swatch.large {
    width: 100%;
    height: 22px;
    border-radius: 8px;
    margin-top: 6px;
}

.loadout-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    -unity-background-scale-mode: scale-and-crop;
}

.loadout-row-btn {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 10px;
    margin-top: 8px;
    border-radius: 12px;
    background-color: rgba(24, 36, 58, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.loadout-row-btn:hover {
    background-color: rgba(91, 196, 255, 0.1);
}

.loadout-text {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.loadout-title {
    color: rgb(248, 251, 255);
    font-size: 12px;
}

.loadout-sub {
    color: rgba(226, 235, 246, 0.6);
    font-size: 10px;
    margin-top: 1px;
    -unity-text-align: lower-left;
    white-space: normal;
    text-overflow: ellipsis;
    flex-grow: 1;
}

.loadout-chevron {
    color: rgba(226, 235, 246, 0.4);
    margin-left: 6px;
}

.loadout-gear-row {
    flex-direction: row;
    align-items: stretch;
    gap: 10px;
    margin-top: 10px;
    padding: 10px;
    border-radius: 12px;
    background-color: rgba(24, 36, 58, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.loadout-slot {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    border-radius: 12px;
    padding: 10px;
    background-color: rgba(24, 36, 58, 0.92);
    position: relative;
    justify-content: center;
}

.loadout-colour {
    width: 110px;
    min-width: 110px;
    flex-shrink: 0;
    border-radius: 12px;
    padding: 10px;
    background-color: rgba(24, 36, 58, 0.92);
}

.loadout-pattern {
    width: 120px;
    min-width: 120px;
    flex-shrink: 0;
    border-radius: 12px;
    padding: 10px;
    background-color: rgba(24, 36, 58, 0.92);
    flex-direction: column;
}

.slot-title {
    color: rgb(248, 251, 255);
    font-size: 11px;
}

.slot-title.small {
    font-size: 10px;
    opacity: 0.85;
}

.slot-sub {
    color: rgba(226, 235, 246, 0.6);
    font-size: 10px;
    margin-top: 2px;
}

.pattern-thumb {
    width: 56px;
    height: 28px;
    border-radius: 8px;
    margin-top: 0;
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 1;
    flex-grow: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding: 0;
}

.loadout-badge {
    position: relative;
    top: auto;
    right: auto;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 999px;
    font-size: 9px;
    color: rgba(244, 248, 255, 0.92);
    background-color: rgba(91, 196, 255, 0.14);
    flex-shrink: 0;
    align-self: center;
    -unity-text-align: middle-center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.24);
    border-right-color: rgba(91, 196, 255, 0.24);
    border-top-color: rgba(91, 196, 255, 0.24);
    border-bottom-color: rgba(91, 196, 255, 0.24);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.loadout-badge.is-equipped {
    background-color: rgba(91, 196, 255, 0.16);
}

.loadout-badge.is-preview {
    background-color: rgba(230, 189, 61, 0.16);
    color: rgb(247, 224, 140);
    position: relative;
    border-left-color: rgba(230, 189, 61, 0.24);
    border-right-color: rgba(230, 189, 61, 0.24);
    border-top-color: rgba(230, 189, 61, 0.24);
    border-bottom-color: rgba(230, 189, 61, 0.24);
}

.color-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    justify-content: center;
    align-items: center;
}

.color-popover {
    width: 320px;
    padding: 12px;
    background-color: rgba(10, 16, 28, 0.98);
    border-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.color-popover-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.color-preview {
    height: 46px;
    border-radius: 10px;
    margin-bottom: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.hsv-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.hsv-label {
    width: 18px;
    color: rgba(226, 235, 246, 0.78);
    font-size: 11px;
    unity-text-align: middle-left;
}

.color-slider {
    flex-grow: 1;
}

.color-presets {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
}

.color-preset-swatch {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.loadout-top-row {
    flex-direction: row;
    align-items: stretch;
    gap: 8px;
    margin-top: 6px;
    margin-bottom: 8px;
}

.eye-controls-column {
    flex-direction: row;
    align-items: stretch;
    gap: 8px;
    min-width: 0;
    margin-right: 8px;
}

.eye-style-column {
    flex-direction: column;
    min-width: 52px;
    max-width: 60px;
    justify-content: flex-start;
}

.eye-style-column-right {
    align-items: center;
}

.eye-style-label {
    color: rgb(248, 251, 255);
    font-size: 10px;
    margin-bottom: 3px;
}

.eye-style-label.subtle {
    color: rgba(226, 235, 246, 0.68);
    margin-bottom: 0;
    margin-right: 4px;
}

.eye-outline-color {
    border-left-color: rgba(255, 222, 120, 0.42);
    border-right-color: rgba(255, 222, 120, 0.42);
    border-top-color: rgba(255, 222, 120, 0.42);
    border-bottom-color: rgba(255, 222, 120, 0.42);
}

.eye-size-panel {
    flex-grow: 1;
    min-width: 104px;
    justify-content: center;
}

.eye-size-slider {
    flex-grow: 1;
    min-width: 104px;
    margin-top: 2px;
}

.eye-size-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    min-height: auto;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    flex-wrap: nowrap;
}

.eye-size-slider .unity-base-slider__dragger {
    border-radius: 999px;
    background-color: rgb(230, 189, 61);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 244, 198, 0.65);
    border-right-color: rgba(255, 244, 198, 0.65);
    border-top-color: rgba(255, 244, 198, 0.65);
    border-bottom-color: rgba(255, 244, 198, 0.65);
    align-self: flex-start;
    bottom: auto;
    align-content: stretch;
}

.eye-size-value {
    min-width: 24px;
    color: rgba(244, 248, 255, 0.88);
    font-size: 10px;
    margin-top: 2px;
    -unity-text-align: middle-right;
}

.eye-outline-label {
    margin-top: 4px;
}

.reset-btn {
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.3);
    border-right-color: rgba(91, 196, 255, 0.3);
    border-top-color: rgba(91, 196, 255, 0.3);
    border-bottom-color: rgba(91, 196, 255, 0.3);
    position: relative;
    top: auto;
    right: auto;
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    border-top-left-radius: 0;
    border-top-right-radius: 999px;
    border-bottom-right-radius: 999px;
    border-bottom-left-radius: 0;
    align-self: flex-start;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.preview-clear-btn {
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.3);
    border-right-color: rgba(91, 196, 255, 0.3);
    border-top-color: rgba(91, 196, 255, 0.3);
    border-bottom-color: rgba(91, 196, 255, 0.3);
    position: absolute;
    top: -3px;
    right: -3px;
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-right-radius: 999px;
    border-bottom-left-radius: 999px;
    align-self: center;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.pattern-reset-btn {
    position: relative;
    right: auto;
    top: auto;
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
    align-self: flex-start;
}

.skin-mini {
    width: 84px;
    min-width: 84px;
    padding: 8px;
    border-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.22);
    border-right-color: rgba(255, 255, 255, 0.22);
    border-bottom-color: rgba(255, 255, 255, 0.22);
    border-left-color: rgba(255, 255, 255, 0.22);
    background-color: rgba(24, 36, 58, 0.92);
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}

.skin-mini-swatch {
    width: 100%;
    min-width: 52px;
    height: 52px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.16);
    border-right-color: rgba(255, 255, 255, 0.16);
    border-bottom-color: rgba(255, 255, 255, 0.16);
    border-left-color: rgba(255, 255, 255, 0.16);
}

.gear-mini-row {
    margin-top: 8px;
    padding: 8px;
    border-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.22);
    border-right-color: rgba(255, 255, 255, 0.22);
    border-bottom-color: rgba(255, 255, 255, 0.22);
    border-left-color: rgba(255, 255, 255, 0.22);
    background-color: rgba(24, 36, 58, 0.92);
    flex-direction: column;
    gap: 6px;
}

.eye-row {
    flex-grow: 1;
    margin-top: 0;
}

.gear-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.gear-mini-header-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    flex-shrink: 0;
}

.gear-mini-body {
    flex-direction: row;
    align-items: stretch;
    gap: 6px;
    min-height: 50px;
}

.gear-mini-color {
    flex-grow: 1;
    min-width: 0;
    height: auto;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.14);
    border-right-color: rgba(255, 255, 255, 0.14);
    border-bottom-color: rgba(255, 255, 255, 0.14);
    border-left-color: rgba(255, 255, 255, 0.14);
    border-top-left-radius: 5px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 5px;
    min-height: 19px;
    max-height: 38px;
}

.eye-name {
    flex-grow: 1;
    min-width: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

.pattern-name {
    flex-grow: 1;
    min-width: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

.loadout-icon.mini {
    width: 34px;
    min-width: 34px;
    height: 34px;
    border-radius: 8px;
}

.loadout_clear_btn {
    position: relative;
    right: auto;
    bottom: auto;
    left: auto;
    top: auto;
}

.option-row.is-selected {
    background-color: rgba(230, 189, 61, 0.12);
    border-left-color: rgba(230, 189, 61, 0.42);
    border-right-color: rgba(230, 189, 61, 0.42);
    border-top-color: rgba(230, 189, 61, 0.42);
    border-bottom-color: rgba(230, 189, 61, 0.42);
}

.option-row.is-preview {
    background-color: rgba(230, 189, 61, 0.08);
    border-left-color: rgba(230, 189, 61, 0.3);
    border-right-color: rgba(230, 189, 61, 0.3);
    border-top-color: rgba(230, 189, 61, 0.3);
    border-bottom-color: rgba(230, 189, 61, 0.3);
}

.option-row.is-equipped {
    background-color: rgba(91, 196, 255, 0.08);
    border-left-color: rgba(91, 196, 255, 0.28);
    border-right-color: rgba(91, 196, 255, 0.28);
    border-top-color: rgba(91, 196, 255, 0.28);
    border-bottom-color: rgba(91, 196, 255, 0.28);
}

.gear-mini-row.is-pattern-target {
    background-color: rgba(230, 189, 61, 0.1);
    border-left-color: rgba(230, 189, 61, 0.38);
    border-right-color: rgba(230, 189, 61, 0.38);
    border-top-color: rgba(230, 189, 61, 0.38);
    border-bottom-color: rgba(230, 189, 61, 0.38);
}

.gear-mini-pattern.is-pattern-target {
    background-color: rgba(230, 189, 61, 0.1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 189, 61, 0.34);
    border-right-color: rgba(230, 189, 61, 0.34);
    border-top-color: rgba(230, 189, 61, 0.34);
    border-bottom-color: rgba(230, 189, 61, 0.34);
}

.pattern-thumb-wrap.is-pattern-target {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 226, 120, 0.9);
    border-right-color: rgba(255, 226, 120, 0.9);
    border-top-color: rgba(255, 226, 120, 0.9);
    border-bottom-color: rgba(255, 226, 120, 0.9);
    background-color: rgba(230, 189, 61, 0.16);
}

.gear-mini-row {
    margin-top: 7px;
    padding: 7px;
    gap: 4px;
}

.gear-mini-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 20px;
}

.eye-body {
    min-height: 48px;
}

.eye-color {
    width: 48px;
    min-width: 48px;
    max-width: 48px;
    height: 48px;
}

.eye-icon-slot {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    gap: 6px;
    border-radius: 10px;
    background-color: rgba(24, 36, 58, 0.92);
    min-width: 0;
}

.gear-mini-pattern {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    align-items: stretch;
    gap: 6px;
    padding: 4px 6px;
    border-radius: 10px;
    background-color: rgba(24, 36, 58, 0);
    align-self: stretch;
    align-content: stretch;
}

.pattern-thumb-wrap {
    width: 50px;
    min-width: 50px;
    height: 30px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-and-crop;
    position: relative;
    flex-shrink: 0;
    border-left-color: rgba(255, 255, 255, 0.14);
    border-right-color: rgba(255, 255, 255, 0.14);
    border-top-color: rgba(255, 255, 255, 0.14);
    border-bottom-color: rgba(255, 255, 255, 0.14);
    border-top-left-radius: 5px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.loadout-icon.mini {
    width: 30px;
    min-width: 30px;
    height: 30px;
}

.loadout-purchase-row {
    flex-direction: row;
    gap: 6px;
    margin-top: 2px;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 0;
}

.loadout-buy-btn {
    flex-grow: 1;
    min-height: auto;
    padding-left: 6px;
    padding-right: 6px;
    font-size: 10px;
    background-color: rgba(91, 196, 255, 0.14);
    color: rgb(223, 244, 255);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 196, 255, 0.3);
    border-right-color: rgba(91, 196, 255, 0.3);
    border-top-color: rgba(91, 196, 255, 0.3);
    border-bottom-color: rgba(91, 196, 255, 0.3);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    height: 8px;
}

.loadout-buy-btn.primary {
    background-color: rgba(230, 189, 61, 0.92);
    color: rgb(18, 24, 34);
    border-left-color: rgba(255, 239, 179, 0.55);
    border-right-color: rgba(255, 239, 179, 0.55);
    border-top-color: rgba(255, 239, 179, 0.55);
    border-bottom-color: rgba(255, 239, 179, 0.55);
}

.loadout-buy-btn:disabled {
    opacity: 0.45;
}

.gear-mini-color-slot {
    width: 92px;
    min-width: 92px;
    max-width: 92px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 4px;
    padding: 4px;
    border-radius: 10px;
    background-color: rgba(24, 36, 58, 0.92);
}

.gear-mini-color-main {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4px;
    position: relative;
}

.gear-mini-extra-colors {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4px;
    min-height: auto;
    align-items: flex-start;
    height: 19px;
    flex-grow: 1;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.14);
    border-right-color: rgba(255, 255, 255, 0.14);
    border-top-color: rgba(255, 255, 255, 0.14);
    border-bottom-color: rgba(255, 255, 255, 0.14);
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

.gear-mini-extra-color {
    height: 16px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(255, 255, 255, 0.18);
    border-left-color: rgba(255, 255, 255, 0.18);
    flex-grow: 1;
}

.gear-mini-extra-color:hover {
    opacity: 0.9;
}

.gear-mini-extra-colors.is-unavailable {
    opacity: 0.32;
}

.gear-mini-extra-colors.is-unavailable > .gear-mini-extra-color {
    opacity: 0.45;
}

Button.is-unavailable {
    opacity: 0.35;
}