.activity-fanfare-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/alte_haas_grotesk/AlteHaasGroteskBold.ttf?fileID=12800000&guid=359a30fefe6c5ca4384ee1df598c6e22&type=3#AlteHaasGroteskBold");
}

.activity-fanfare-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 18%;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.activity-fanfare-headline {
    unity-text-align: middle-center;
    font-size: 70px;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    -unity-font-definition: url("project://database/Assets/Lots%20of%20fonts/Slackey.ttf?fileID=12800000&guid=281591823e5a02d439cd5679a23ed27e&type=3#Slackey");
    -unity-text-outline-color: rgb(8, 14, 26);
    -unity-text-outline-width: 4px;
    margin-bottom: 2px;
}

.activity-fanfare-detail {
    unity-text-align: middle-center;
    font-size: 24px;
    color: rgba(248, 251, 255, 0.98);
    letter-spacing: 0.4px;
    -unity-text-outline-color: rgba(8, 14, 26, 0.92);
    -unity-text-outline-width: 2px;
    white-space: normal;
    max-width: 760px;
    padding-left: 16px;
    padding-right: 16px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}
