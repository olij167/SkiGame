  id: tutorial.move_and_lean
  title: Move and Lean
  description: Start by feeling how forward and backward lean shape your momentum
    on the snow.
  autoAccept: 0
  tutorialQuest: 1
  stages:
  - id: tutorial.move_and_lean.stage1
    title: Learn Your Weight Shift
    description: Lean forward to build speed, then lean back to feel how your stance
      calms the skis down.
