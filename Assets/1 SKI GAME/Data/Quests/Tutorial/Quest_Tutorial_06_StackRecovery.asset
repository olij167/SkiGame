  id: tutorial.stack_recovery
  title: Recover from a Stack
  description: If you topple into a stacked state, switch to walking, reset yourself,
    and put the skis back on.
  autoAccept: 0
  tutorialQuest: 1
  stages:
  - id: tutorial.stack_recovery.stage1
    title: Reset Yourself
    description: A stack means you are no longer in a clean skiing stance. Remove
      the skis, get upright, then put them back on.
    objectives:
    - id: tutorial.stack_recovery.stacked
      title: Stack once
      description: Crash or land awkwardly enough to topple into a stacked state.
