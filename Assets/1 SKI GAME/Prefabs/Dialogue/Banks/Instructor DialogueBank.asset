  - id: tutorialReady
    topic: tutorialReady
    trigger: 6
    audience: 0
    priority: 17
    weight: 1
    text: Nice work! Come back and chat with me for your next task.
    duration: 12
    cooldown: 0
    avoidImmediateRepeat: 1
    showSpeakerName: 0
