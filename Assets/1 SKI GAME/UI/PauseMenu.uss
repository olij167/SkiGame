.pause-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.pause-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

.pause-shell {
    width: 1180px;
    max-width: 96%;
    height: 720px;
    max-height: 94%;
    align-items: center;
    justify-content: center;
}

.pause-screen {
    width: 100%;
    height: 100%;
    min-height: 0;
    align-items: center;
    justify-content: center;
}

/* =========================
   SHARED VISUAL LANGUAGE
   Matched to MainMenu.uss
   ========================= */

.hero-card {
    width: 520px;
    max-width: 92%;
    padding: 28px;
    border-radius: 18px;
    background-color: rgba(18, 26, 36, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    align-items: center;
}

.hero-title {
    font-size: 64px;
    unity-font-style: bold;
    color: rgb(240, 248, 255);
    unity-text-align: middle-center;
    margin-bottom: 8px;
}

.hero-subtitle {
    font-size: 16px;
    color: rgba(230, 238, 247, 0.86);
    unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 22px;
}

.hero-actions {
    width: 100%;
    gap: 12px;
    margin-bottom: 16px;
}

.hero-footnote {
    font-size: 12px;
    color: rgba(215, 225, 236, 0.58);
    unity-text-align: middle-center;
}

.page-card {
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-grow: 1;
    padding: 22px;
    border-radius: 18px;
    background-color: rgba(18, 26, 36, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.page-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.page-title {
    font-size: 30px;
    unity-font-style: bold;
    color: rgb(240, 248, 255);
}

.settings-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.settings-group {
    margin-bottom: 16px;
    padding: 16px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.group-title {
    font-size: 18px;
    unity-font-style: bold;
    color: rgb(245, 250, 255);
    margin-bottom: 12px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
}

.setting-label {
    width: 170px;
    font-size: 14px;
    color: rgba(225, 233, 243, 0.82);
}

.setting-slider {
    flex-grow: 1;
}

.setting-dropdown {
    flex-grow: 1;
}

.setting-toggle {
    flex-grow: 1;
    align-items: flex-end;
}

.setting-value {
    width: 70px;
    font-size: 13px;
    color: rgb(245, 250, 255);
    unity-text-align: upper-right;
}

.settings-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.settings-note {
    font-size: 12px;
    color: rgba(215, 225, 236, 0.62);
    margin-top: 6px;
}

.menu-button {
    height: 46px;
    border-radius: 12px;
    font-size: 15px;
    unity-font-style: bold;
    color: rgb(240, 248, 255);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.menu-button:active {
    background-color: rgba(255, 255, 255, 0.16);
}

.menu-button-primary {
    background-color: rgba(95, 155, 255, 0.3);
    border-color: rgba(140, 190, 255, 0.72);
}

.menu-button-primary:hover {
    background-color: rgba(95, 155, 255, 0.42);
}

.menu-button-danger {
    background-color: rgba(150, 50, 50, 0.28);
    border-color: rgba(220, 120, 120, 0.6);
}

.menu-button-danger:hover {
    background-color: rgba(170, 60, 60, 0.38);
}

.small-button {
    min-width: 120px;
    height: 40px;
    border-radius: 10px;
    font-size: 14px;
    unity-font-style: bold;
    color: rgb(240, 248, 255);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.small-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.controls-toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
}

.controls-status {
    flex-grow: 1;
    font-size: 13px;
    color: rgba(225, 233, 243, 0.82);
}

.controls-status.is-listening {
    color: rgb(245, 250, 255);
}

.controls-note {
    font-size: 12px;
    color: rgba(215, 225, 236, 0.62);
    margin-bottom: 12px;
}

.controls-rebind-list {
    gap: 10px;
    padding-top: 2px;
    padding-bottom: 6px;
}

.controls-rebind-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 8px;
}

.controls-rebind-row.is-listening {
    background-color: rgba(95, 155, 255, 0.16);
    border-color: rgba(140, 190, 255, 0.72);
}

.controls-rebind-action {
    width: 220px;
    font-size: 14px;
    color: rgb(245, 250, 255);
    unity-font-style: bold;
}

.controls-rebind-binding {
    flex-grow: 1;
    font-size: 14px;
    color: rgba(225, 233, 243, 0.82);
}

.controls-rebind-binding.is-listening {
    color: rgb(245, 250, 255);
}

.controls-rebind-btn {
    min-width: 110px;
    height: 40px;
    border-radius: 10px;
    font-size: 14px;
    unity-font-style: bold;
    color: rgb(240, 248, 255);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.controls-rebind-btn:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.unity-scroll-view__content-container {
    flex-grow: 1;
}