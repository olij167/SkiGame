.menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.menu-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(10, 12, 16);
}

.menu-frame {
    width: 1100px;
    max-width: 96%;
    height: 680px;
    max-height: 92%;
    border-radius: 18px;
    background-color: rgba(135, 206, 235, 0.5);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    padding: 18px;
}

.menu-header {
    flex-direction: column;
    padding: 10px 10px 16px 10px;
}

.menu-title {
    font-size: 26px;
    unity-font-style: bold;
    color: rgb(95, 126, 161);
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(95, 126, 161);
    -unity-text-outline-width: 4px;
    text-shadow: 0 0 0 rgb(95, 126, 161);
}

.menu-subtitle {
    font-size: 12px;
    color: rgb(95, 126, 161);
    margin-top: 2px;
}

.menu-body {
    flex-direction: row;
    flex-grow: 1;
    gap: 14px;
}

.menu-nav {
    width: 240px;
    min-width: 220px;
    flex-direction: column;
    gap: 10px;
    padding: 10px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.spacer {
    flex-grow: 1;
}

.menu-footnote {
    font-size: 11px;
    color: rgba(200, 205, 215, 0.55);
    margin-top: 6px;
}

.menu-content {
    flex-grow: 1;
    flex-direction: column;
    padding: 10px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

.panel {
    flex-grow: 1;
    flex-direction: column;
    padding: 14px;
    background-color: rgba(95, 126, 161, 0.75);
}

.panel-title {
    font-size: 18px;
    unity-font-style: bold;
    color: rgb(224, 255, 255);
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.panel-body {
    font-size: 12px;
    color: rgb(224, 255, 255);
    margin-bottom: 8px;
}

.panel-sep {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.06);
    margin: 10px 0;
    color: rgb(224, 255, 255);
}

.panel-inline {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: rgb(224, 255, 255);
}

.muted {
    color: rgb(224, 255, 255);
    -unity-font-style: bold;
}

.warn-text {
    color: rgba(155, 125, 130, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.two-col {
    flex-grow: 1;
    flex-direction: row;
    gap: 12px;
}

.slot-list {
    width: 360px;
    min-width: 320px;
    flex-direction: column;
    gap: 10px;
}

.slot-card {
    flex-direction: row;
    align-items: flex-start;
    gap: 10px;
    padding: 10px;
    border-radius: 12px;
    background-color: rgba(95, 126, 161, 0.75);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    flex-grow: 1;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.slot-meta {
    flex-grow: 1;
    flex-direction: column;
    gap: 2px;
}

.slot-title {
    font-size: 13px;
    unity-font-style: bold;
    color: rgb(224, 255, 255);
}

.slot-sub {
    font-size: 11px;
    color: rgb(224, 255, 255);
}

.preview-card {
    flex-grow: 1;
    flex-direction: column;
    padding: 12px;
    border-radius: 12px;
    background-color: rgba(95, 126, 161, 0.75);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.preview-title {
    font-size: 13px;
    unity-font-style: bold;
    color: rgb(224, 255, 255);
}

.preview-big {
    font-size: 16px;
    unity-font-style: bold;
    color: rgb(224, 255, 255);
}

.kv {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.kv-key {
    font-size: 12px;
    color: rgb(224, 255, 255);
}

.kv-val {
    font-size: 12px;
    color: rgba(245, 245, 245, 0.9);
}

.settings-scroll {
    flex-grow: 1;
}

.settings-group {
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
    padding: 10px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.02);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.group-title {
    font-size: 13px;
    unity-font-style: bold;
    color: rgb(224, 255, 255);
    margin-bottom: 4px;
}

.field {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.field-label {
    width: 160px;
    font-size: 12px;
    color: rgb(224, 255, 255);
}

.field-value {
    width: 58px;
    text-align: right;
    font-size: 11px;
}

.field-slider {
    flex-grow: 1;
}

.field-toggle {
    flex-grow: 1;
    justify-content: flex-end;
}

.field-dropdown {
    flex-grow: 1;
}

.btn {
    height: 40px;
    border-radius: 12px;
    unity-font-style: bold;
    font-size: 12px;
    background-color: rgba(95, 126, 161, 0.75);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    color: rgb(224, 255, 255);
}

.btn:hover {
    background-color: rgba(255, 255, 255, 0.75);
    -unity-font-style: bold;
    color: rgb(114, 148, 178);
}

.btn:active {
    background-color: rgba(255, 255, 255, 0.75);
    -unity-font-style: bold;
    color: rgb(114, 148, 178);
}

.btn-main {
    height: 50px;
    border-radius: 12px;
    unity-font-style: bold;
    font-size: 32px;
    border-width: 2px;
    -unity-font-style: bold;
}

.btn-primary {
    background-color: rgb(95, 126, 161);
    border-color: rgba(120, 165, 255, 0.35);
    color: rgb(224, 255, 255);
}

.btn-primary:hover {
    background-color: rgba(120, 165, 255, 0.24);
}

.btn-danger {
    background-color: rgba(161, 97, 95, 0.75);
    border-color: rgba(255, 90, 90, 0.3);
    color: rgb(224, 255, 255);
}

.btn-danger:hover {
    background-color: rgba(255, 90, 90, 0.2);
    color: rgb(224, 255, 255);
    -unity-font-style: bold;
}

.btn-small {
    height: 32px;
    width: 78px;
    border-radius: 10px;
    font-size: 11px;
    background-color: rgba(224, 255, 255, 0.15);
}

.panel-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
}

.modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

.modal-card {
    width: 520px;
    max-width: 92%;
    border-radius: 16px;
    padding: 16px;
    background-color: rgba(18, 21, 28, 0.98);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.modal-title {
    font-size: 16px;
    unity-font-style: bold;
    color: rgb(245, 245, 245);
}

.modal-body {
    font-size: 12px;
    margin-top: 6px;
}

.hidden {
    display: none;
}

.slot-selected {
    border-left-width: 3px;
    border-left-color: rgba(120, 170, 255, 0.6);
}

.slot-selected {
    border-left-width: 3px;
    border-left-color: rgba(120, 170, 255, 0.6);
}
