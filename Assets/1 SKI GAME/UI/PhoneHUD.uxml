<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/1%20SKI%20GAME/UI/PhoneHUD.uss?fileID=7433441132597879392&amp;guid=da161d3ed5064d84b9b72ddb153dfb63&amp;type=3#PhoneHUD" />
    <ui:VisualElement name="PhoneHUDRoot" class="phonehud-root">
        <ui:VisualElement name="WatchCollapsed" class="watch-collapsed">
            <ui:VisualElement class="watch-frame">
                <ui:VisualElement class="watch-header">
                    <ui:Label name="Lbl_WatchTitle" text="Speed" class="watch-title" />
<ui:VisualElement name="WatchDots" class="watch-dots">
    <ui:VisualElement class="dot is-on" />
    <ui:VisualElement class="dot" />
    <ui:VisualElement class="dot" />
    <ui:VisualElement class="dot" />
    <ui:VisualElement class="dot" />
    <ui:VisualElement class="dot" />
</ui:VisualElement>

                </ui:VisualElement>
                <ui:VisualElement name="WatchPages" class="watch-pages">
                   <ui:ScrollView name="WatchPage_Speed" class="watch-page">
                        <!-- Notification bar (no outline) -->
                        <ui:VisualElement class="watch-speed-topbar">
                            <ui:Label name="Lbl_WatchSpeedTime" text="--:--" class="watch-speed-time" />
                            <ui:Label name="Lbl_WatchSpeedWeather" text="---  --C" class="watch-speed-weather" />
                        </ui:VisualElement>

                        <!-- Spacer (keeps layout stable, no scrolling needed) -->
                        <ui:VisualElement class="watch-speed-spacer" />

                        <!-- Bottom row: Airtime (left) + Speed gauge (right) -->
                        <ui:VisualElement class="watch-speed-bottom">
                           <ui:VisualElement name="WatchAirBox" class="watch-air-min">
                                <ui:Label name="Lbl_WatchAirTime" text="0.00s" class="watch-air-time" />
                                <ui:Label name="Lbl_WatchAirHint" text="LAST" class="watch-air-tag" />
                            </ui:VisualElement>


                            <ui:VisualElement class="watch-speed-gauge">
                                <ui:Label name="Lbl_WatchSpeed" text="0.0" class="watch-big" />
                                <ui:Label text="m/s" class="watch-unit" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>

                    <ui:ScrollView name="WatchPage_Session" class="watch-page">
                        <!-- <ui:Label text="Session" class="watch-section" /> -->
                        <ui:Label name="Lbl_WatchSessTopSpeed" text="Top: 0.0 m/s" class="watch-kv" />
                        <ui:Label name="Lbl_WatchSessDist" text="Dist: 0 m" class="watch-kv" />
                        <ui:Label name="Lbl_WatchSessVert" text="Vert: +0 / -0" class="watch-kv" />
                        <ui:Label name="Lbl_WatchSessStacks" text="Stacks: 0" class="watch-kv" />
                    </ui:ScrollView>
                    <ui:ScrollView name="WatchPage_Lifetime" class="watch-page">
                        <!-- <ui:Label text="Lifetime" class="watch-section" /> -->
                        <ui:Label name="Lbl_WatchLifeTopSpeed" text="Top: 0.0 m/s" class="watch-kv" />
                        <ui:Label name="Lbl_WatchLifeDist" text="Dist: 0 m" class="watch-kv" />
                        <ui:Label name="Lbl_WatchLifeVert" text="Vert: +0 / -0" class="watch-kv" />
                        <ui:Label name="Lbl_WatchLifeStacks" text="Stacks: 0" class="watch-kv" />
                    </ui:ScrollView>
                    <ui:ScrollView name="WatchPage_Tasks" class="watch-page">
                        <!-- <ui:Label text="Tasks" class="watch-section" /> -->
                        <ui:Label name="Lbl_WatchTask1" text="(placeholder)" class="watch-kv" />
                        <ui:Label name="Lbl_WatchTask2" text="(placeholder)" class="watch-kv" />
                        <ui:Label name="Lbl_WatchTask3" text="(placeholder)" class="watch-kv" />
                    </ui:ScrollView>
                    <ui:ScrollView name="WatchPage_Achievements" class="watch-page">
                        <!-- <ui:Label text="Achievements" class="watch-section" /> -->
                        <ui:Label name="Lbl_WatchAch1" text="(placeholder)" class="watch-kv" />
                        <ui:Label name="Lbl_WatchAch2" text="(placeholder)" class="watch-kv" />
                        <ui:Label text="Categories + tiers come next" class="watch-sub" />
                    </ui:ScrollView>
                    <!-- <ui:ScrollView name="WatchPage_SOS" class="watch-page">
                        <ui:Label text="SOS" class="watch-section" />
                        <ui:Label text="Respawn to last safe point." class="watch-sub" />
                        <ui:VisualElement class="watch-divider" />
                        <ui:VisualElement name="Btn_WatchSOS" class="watch-action">
                            <ui:Label text="RESPAWN" class="watch-action-text" />
                        </ui:VisualElement>
                    </ui:ScrollView> -->
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="PhoneExpanded" class="phone-expanded">
            <ui:VisualElement class="phone-shell">
                <ui:VisualElement class="phone-topbar">
                    <ui:VisualElement name="Btn_ClosePhone" class="icon-btn">
                        <ui:Label text="x" class="icon-btn-text" />
                    </ui:VisualElement>
                    <ui:Label name="Lbl_PhoneHeader" text="Mountain Tracker" class="phone-title" />
                    <ui:VisualElement class="phone-spacer" />
                </ui:VisualElement>
               <ui:VisualElement class="phone-navbar">
    <ui:VisualElement name="Btn_Back" class="nav-btn">
        <ui:Label text="Back" class="nav-btn-text" />
    </ui:VisualElement>

    <ui:Label name="Lbl_PageTitle" text="Home" class="nav-title" />

    <ui:VisualElement class="nav-spacer" />
    <ui:Label name="Lbl_Currency" text="$0" class="nav-currency" />
</ui:VisualElement>

                <ui:VisualElement name="PhonePages" class="phone-pages">
                    <ui:ScrollView name="Page_Home" class="phone-page">
                        <ui:VisualElement class="home-grid">
<ui:VisualElement class="home-row row-small">
    <ui:VisualElement name="Tile_Status" class="tile tile-small tile-wide">
        <ui:VisualElement class="status-body">

            <!-- LEFT: Time (top), Date, Sunrise/Sunset -->
            <ui:VisualElement class="status-left">
                <ui:Label name="Lbl_TileTime" text="--:-- AM" class="status-time" />
                <ui:Label name="Lbl_TileDate" text="---" class="status-date" />
                <ui:Label name="Lbl_TileSunTimes" text="Sunrise: --:-- AM | Sunset: --:-- PM" class="status-sun" />
            </ui:VisualElement>

            <!-- RIGHT: Temp + Conditions -->
            <ui:VisualElement class="status-right">
                <!-- ASCII ONLY placeholders in UXML -->
                <ui:Label name="Lbl_TileTemp" text="-- C" class="status-temp" />
                <ui:Label name="Lbl_TileWeather" text="---" class="status-cond" />
                <ui:Label name="Lbl_TileRain" text="Rain: --%" class="status-rain" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:VisualElement>


                            <ui:VisualElement class="home-row row-tall">
                                <ui:VisualElement name="Tile_Stats" class="tile tile-tall tile-stats">
    <ui:VisualElement class="tile-head">
        <ui:Label text="Stats" class="tile-title" />
        <ui:Label text="Session" class="tile-badge" />
    </ui:VisualElement>

    <ui:Label name="Lbl_TileStatsLine1" text="--" class="tile-value" />

    <ui:VisualElement class="tile-minirow">
        <ui:Label name="Lbl_TileStatsLine2" text="--" class="tile-sub" />
        <ui:Label name="Lbl_TileStatsLine3" text="--" class="tile-sub" />
    </ui:VisualElement>
</ui:VisualElement>

                                <ui:VisualElement name="Tile_Tasks" class="tile tile-tall tile-tasks">
    <ui:VisualElement class="tile-head">
        <ui:Label text="Tasks" class="tile-title" />
        <ui:Label name="Lbl_TileTasksProgress" text="0/0" class="tile-badge" />
    </ui:VisualElement>

    <ui:VisualElement class="tile-progress">
        <ui:VisualElement name="TileTasksProgressFill" class="tile-progress-fill" />
    </ui:VisualElement>

    <ui:Label name="Lbl_TileTask1" text="Task 1" class="tile-sub tile-taskline" />
    <ui:Label name="Lbl_TileTask2" text="Task 2" class="tile-sub tile-taskline" />
    <ui:Label name="Lbl_TileTask3" text="Task 3" class="tile-sub tile-taskline" />
</ui:VisualElement>

                            </ui:VisualElement>
                            <ui:VisualElement class="home-row row-medium">
                                <ui:VisualElement name="Tile_Achievements" class="tile tile-medium">
                                    <ui:Label text="Achievements" class="tile-title" />
                                    <ui:Label name="Lbl_TileAch1" text="(placeholder)" class="tile-sub" />
                                    <ui:Label name="Lbl_TileAch2" text="(placeholder)" class="tile-sub" />
                                </ui:VisualElement>
                                <ui:VisualElement name="Tile_Map" class="tile tile-medium">
                                    <ui:Label text="Map" class="tile-title" />
                                    <ui:Label text="(placeholder)" class="tile-sub" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="home-row row-mini3">
    <ui:VisualElement name="Tile_Camera" class="tile tile-mini">
        <ui:Label text="Camera" class="tile-title" />
        <ui:Label text="(soon)" class="tile-sub" />
    </ui:VisualElement>

    <ui:VisualElement name="Tile_Shop" class="tile tile-mini">
        <ui:Label text="Shop" class="tile-title" />
        <ui:Label text="(soon)" class="tile-sub" />
    </ui:VisualElement>

    <ui:VisualElement name="Tile_Customise" class="tile tile-mini">
        <ui:Label text="Customise" class="tile-title" />
        <ui:Label text="(soon)" class="tile-sub" />
    </ui:VisualElement>
</ui:VisualElement>

                            <ui:VisualElement class="home-row row-mini">
                                <ui:VisualElement name="Tile_Save" class="tile tile-mini">
                                    <ui:Label text="Save" class="tile-title" />
                                    <ui:Label text="(placeholder)" class="tile-sub" />
                                </ui:VisualElement>
                                <ui:VisualElement name="Tile_Settings" class="tile tile-mini">
                                    <ui:Label text="Settings" class="tile-title" />
                                </ui:VisualElement>
                                <ui:VisualElement name="Tile_SOS" class="tile tile-mini">
                                    <ui:Label text="SOS" class="tile-title" />
                                    <ui:Label text="Respawn" class="tile-sub" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
<ui:ScrollView name="Page_Stats" class="phone-page">
    <ui:Label text="Stats" class="page-h1" />

    <!-- Segmented tabs -->
    <ui:VisualElement class="seg-tabs">
        <ui:VisualElement name="Btn_StatsTabSession" class="seg-tab is-on">
            <ui:Label text="Session" class="seg-tab-text" />
        </ui:VisualElement>
        <ui:VisualElement name="Btn_StatsTabLifetime" class="seg-tab">
            <ui:Label text="Lifetime" class="seg-tab-text" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- SESSION PANEL -->
    <ui:VisualElement name="Panel_StatsSession" class="stats-panel is-active">
        <ui:VisualElement class="metric-grid">
            <ui:VisualElement class="metric-card">
                <ui:Label text="Top speed" class="metric-key" />
                <ui:Label name="Lbl_StatsS_TopSpeed" text="--" class="metric-val" />
            </ui:VisualElement>
            <ui:VisualElement class="metric-card">
                <ui:Label text="Distance" class="metric-key" />
                <ui:Label name="Lbl_StatsS_Distance" text="--" class="metric-val" />
            </ui:VisualElement>
            <ui:VisualElement class="metric-card">
                <ui:Label text="Vertical" class="metric-key" />
                <ui:Label name="Lbl_StatsS_Vert" text="--" class="metric-val" />
            </ui:VisualElement>
            <ui:VisualElement class="metric-card">
                <ui:Label text="Stacks" class="metric-key" />
                <ui:Label name="Lbl_StatsS_Stacks" text="--" class="metric-val" />
            </ui:VisualElement>

    <ui:VisualElement class="metric-card metric-card-secondary">
        <ui:Label text="Air time" class="metric-key" />
        <ui:Label name="Lbl_StatsS_AirTime" text="--" class="metric-val" />
    </ui:VisualElement>

    <ui:VisualElement class="metric-card">
        <ui:Label text="Air dist" class="metric-key" />
        <ui:Label name="Lbl_StatsS_AirDist" text="--" class="metric-val" />
    </ui:VisualElement>

    <ui:VisualElement class="metric-card">
        <ui:Label text="Runs" class="metric-key" />
        <ui:Label name="Lbl_StatsS_Runs" text="--" class="metric-val" />
    </ui:VisualElement>

    <ui:VisualElement class="metric-card">
        <ui:Label text="Lifts" class="metric-key" />
        <ui:Label name="Lbl_StatsS_Lifts" text="--" class="metric-val" />
    </ui:VisualElement>
</ui:VisualElement>

    </ui:VisualElement>

    <!-- LIFETIME PANEL -->
    <ui:VisualElement name="Panel_StatsLifetime" class="stats-panel">
        <ui:VisualElement class="metric-grid">
            <ui:VisualElement class="metric-card">
                <ui:Label text="Top speed" class="metric-key" />
                <ui:Label name="Lbl_StatsL_TopSpeed" text="--" class="metric-val" />
            </ui:VisualElement>
            <ui:VisualElement class="metric-card">
                <ui:Label text="Total dist" class="metric-key" />
                <ui:Label name="Lbl_StatsL_Distance" text="--" class="metric-val" />
            </ui:VisualElement>
            <ui:VisualElement class="metric-card">
                <ui:Label text="Total vert" class="metric-key" />
                <ui:Label name="Lbl_StatsL_Vert" text="--" class="metric-val" />
            </ui:VisualElement>
            <ui:VisualElement class="metric-card">
                <ui:Label text="Total stacks" class="metric-key" />
                <ui:Label name="Lbl_StatsL_Stacks" text="--" class="metric-val" />
            </ui:VisualElement>

    <ui:VisualElement class="metric-card">
        <ui:Label text="Avg speed" class="metric-key" />
        <ui:Label name="Lbl_StatsL_AvgSpeed" text="--" class="metric-val" />
    </ui:VisualElement>

    <ui:VisualElement class="metric-card">
        <ui:Label text="Air time" class="metric-key" />
        <ui:Label name="Lbl_StatsL_AirTime" text="--" class="metric-val" />
    </ui:VisualElement>

    <ui:VisualElement class="metric-card">
        <ui:Label text="Air dist" class="metric-key" />
        <ui:Label name="Lbl_StatsL_AirDist" text="--" class="metric-val" />
    </ui:VisualElement>

    <ui:VisualElement class="metric-card">
        <ui:Label text="Runs" class="metric-key" />
        <ui:Label name="Lbl_StatsL_Runs" text="--" class="metric-val" />
    </ui:VisualElement>

    <ui:VisualElement class="metric-card">
        <ui:Label text="Lifts" class="metric-key" />
        <ui:Label name="Lbl_StatsL_Lifts" text="--" class="metric-val" />
    </ui:VisualElement>
</ui:VisualElement>

    </ui:VisualElement>
</ui:ScrollView>

                    <ui:ScrollView name="Page_Tasks" class="phone-page">
                        <ui:Label text="Tasks" class="page-h1" />
<ui:VisualElement name="TasksList" class="task-list" />
                    </ui:ScrollView>
                   <ui:ScrollView name="Page_Achievements" class="phone-page">
    <ui:Label text="Achievements" class="page-h1" />

    <ui:ScrollView name="Ach_CategoryScroll"
                   class="ach-cat-scroll"
                   mode="Horizontal"
                   vertical-scroller-visibility="Hidden"
                   horizontal-scroller-visibility="Auto">
        <ui:VisualElement name="Ach_CategoryRow" class="ach-cat-row" />
    </ui:ScrollView>

    <ui:VisualElement class="ach-summary">
        <ui:Label name="Lbl_AchSummary" text="--" class="ach-summary-text" />
    </ui:VisualElement>

    <ui:VisualElement name="AchievementsList" class="ach-list" />
</ui:ScrollView>

<ui:ScrollView name="Page_TimeWeather" class="phone-page" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
    <ui:VisualElement class="tw-timeheader">
        <ui:Label name="Lbl_TW_Time" text="--:-- AM" class="tw-time" />
        <ui:VisualElement class="tw-time-subrow">
            <ui:Label name="Lbl_TW_Day" text="---" class="tw-day" />
            <ui:Label name="Lbl_TW_Date" text="---" class="tw-date" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="tw-nowcard">
        <ui:VisualElement class="tw-now-top">
            <ui:Label name="Lbl_TW_CurrentCond" text="---" class="tw-now-cond" />
            <ui:Label name="Lbl_TW_CurrentTemp" text="-- C" class="tw-now-temp" />
        </ui:VisualElement>

        <ui:VisualElement class="tw-now-meta">
            <ui:Label name="Lbl_TW_CurrentRain" text="Rain chance: --%" class="tw-meta" />
            <ui:Label name="Lbl_TW_CurrentWind" text="Wind: --" class="tw-meta" />
        </ui:VisualElement>

        <ui:VisualElement class="tw-sunrow">
            <ui:VisualElement class="tw-sun-chip">
                <ui:Label text="Sunrise" class="tw-chip-label" />
                <ui:Label name="Lbl_TW_Sunrise" text="--:--" class="tw-chip-value" />
            </ui:VisualElement>
            <ui:VisualElement class="tw-sun-chip">
                <ui:Label text="Sunset" class="tw-chip-label" />
                <ui:Label name="Lbl_TW_Sunset" text="--:--" class="tw-chip-value" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:Label text="Hourly Forecast" class="page-h2 tw-hourly-title" />

<ui:VisualElement name="TW_HourlyRegion" class="tw-hourly-region">
   <ui:ScrollView name="TW_HourlyScroll"
               class="tw-hourly-scroll"
               mode="Horizontal"
               vertical-scroller-visibility="Hidden"
               horizontal-scroller-visibility="Auto">
    <ui:VisualElement name="TW_HourlyRow" class="tw-hourly-row" />
</ui:ScrollView>

</ui:VisualElement>
</ui:ScrollView>


                    <ui:ScrollView name="Page_Map" class="phone-page">
                        <ui:Label text="Map" class="page-h1" />
                        <ui:Label text="(placeholder) Runs, lifts, and POIs will populate this later." class="page-body" />
                    </ui:ScrollView>
                    <ui:ScrollView name="Page_Save" class="phone-page">
                        <ui:Label text="Save &amp; Load" class="page-h1" />
                        <ui:Label text="(placeholder) Your stats save automatically; manual saves can come later." class="page-body" />
                    </ui:ScrollView>
                    <ui:ScrollView name="Page_Settings" class="phone-page">
                        <ui:Label text="Settings" class="page-h1" />
                        <ui:Label text="(placeholder) UI, controls, accessibility later." class="page-body" />
                    </ui:ScrollView>
                    <ui:ScrollView name="Page_SOS" class="phone-page">
                        <ui:Label text="SOS" class="page-h1" />
                        <ui:Label text="Respawn to last safe point." class="page-body" />
                        <ui:VisualElement name="Btn_SOSRespawn" class="big-action">
                            <ui:Label text="RESPAWN" class="big-action-text" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
