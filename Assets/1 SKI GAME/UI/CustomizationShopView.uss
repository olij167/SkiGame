.shop-root {
    flex-direction: column;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.35);
    flex-grow: 1;
}

.shop-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.shop-title {
    font-size: 18px;
    unity-font-style: bold;
    color: white;
}

.shop-header-right {
    flex-direction: row;
    align-items: center;
}

.shop-currency {
    margin-right: 10px;
    color: white;
    unity-font-style: bold;
}

.shop-exit {
    padding-left: 10px;
    padding-right: 10px;
}

.shop-body {
    flex-direction: row;
    height: 100%;
}

.shop-panel {
    width: 320px;
    padding: 10px;
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 10px;
    flex-shrink: 0;
    flex-direction: column;
}

.shop-content-column {
    flex-direction: column;
}

.preview-panel {
    flex-grow: 1;
    margin-right: 10px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 10px;
}

.preview-hint {
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
}

.loadout-panel {
    width: 260px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 10px;
    flex-shrink: 0;
    flex-direction: column;
}

.panel-title {
    unity-font-style: bold;
    margin-bottom: 8px;
    color: white;
}

.panel-title.small {
    margin-top: 8px;
    font-size: 12px;
}

.tabs-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.tabs-row.sub {
    margin-bottom: 10px;
}

.tab-btn {
    flex-grow: 1;
    margin-right: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
}

.tab-btn.is-active {
    background-color: rgba(255, 255, 255, 0.2);
    unity-font-style: bold;
}

.tab-btn.is-disabled {
    opacity: 0.35;
}

.options-list {
    height: 320px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
}

.detail-panel {
    flex-grow: 1;
    padding: 10px;
    margin-top: 8px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
}

.detail-header {
    flex-direction: row;
    margin-bottom: 8px;
}

.detail-icon {
    width: 56px;
    height: 56px;
    margin-right: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

.detail-header-text {
    flex-grow: 1;
}

.detail-name {
    color: white;
    margin-top: 4px;
    unity-font-style: bold;
    font-size: 15px;
}

.detail-desc {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
}

.detail-meta {
    margin-top: 6px;
    margin-bottom: 8px;
}

.detail-meta-line {
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
}

.detail-actions {
    flex-direction: row;
    margin-top: 10px;
}

.action-btn {
    flex-grow: 1;
    margin-right: 8px;
}

.action-btn.primary {
    unity-font-style: bold;
}

.is-hidden {
    display: none;
}

.option-row {
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 6px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.12);
}

.option-row:hover {
    background-color: rgba(0, 0, 0, 0.18);
}

.option-icon {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-and-crop;
}

.option-mid {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.option-name {
    color: white;
    font-size: 12px;
    margin-top: 0;
    margin-bottom: 0;
}

.option-meta {
    color: rgba(255, 255, 255, 0.6);
    font-size: 10px;
    margin-top: 1px;
}

.option-right {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.option-price {
    color: rgba(255, 255, 255, 0.85);
    unity-font-style: bold;
    font-size: 12px;
}

.option-badge {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 999px;
    font-size: 10px;
    unity-font-style: bold;
    color: rgba(255, 255, 255, 0.9);
    background-color: rgba(255, 255, 255, 0.07);
}

.option-badge.is-equipped {
    background-color: rgba(0, 255, 160, 0.16);
}

.option-badge.is-owned {
    background-color: rgba(255, 255, 255, 0.09);
}

.option-badge.is-preview {
    background-color: rgba(255, 210, 80, 0.14);
}

.color-swatch {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgb(255, 255, 255);
}

.color-swatch.large {
    width: 100%;
    height: 22px;
    border-radius: 8px;
    margin-top: 6px;
}

.loadout-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    -unity-background-scale-mode: scale-and-crop;
}

.loadout-row-btn {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 10px;
    margin-top: 8px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
}

.loadout-row-btn:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.loadout-text {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.loadout-title {
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    unity-font-style: bold;
}

.loadout-sub {
    color: rgba(255, 255, 255, 0.6);
    font-size: 10px;
    margin-top: 1px;
    -unity-text-align: lower-left;
}

.loadout-chevron {
    color: rgba(255, 255, 255, 0.35);
    margin-left: 6px;
}

.loadout-gear-row {
    flex-direction: row;
    align-items: stretch;
    gap: 10px;
    margin-top: 10px;
    padding: 10px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
}

.loadout-slot {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    border-radius: 12px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    position: relative;
    justify-content: center;
}

.loadout-colour {
    width: 110px;
    min-width: 110px;
    flex-shrink: 0;
    border-radius: 12px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
}

.loadout-pattern {
    width: 120px;
    min-width: 120px;
    flex-shrink: 0;
    border-radius: 12px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    flex-direction: column;
}

.slot-title {
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    unity-font-style: bold;
}

.slot-title.small {
    font-size: 10px;
    opacity: 0.85;
}

.slot-sub {
    color: rgba(255, 255, 255, 0.6);
    font-size: 10px;
    margin-top: 2px;
}

.pattern-thumb {
    width: 100%;
    height: 22px;
    border-radius: 8px;
    margin-top: 6px;
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-and-crop;
}

.loadout-badge {
    position: relative;
    top: 8px;
    right: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 999px;
    font-size: 10px;
    unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
    background-color: rgba(255, 255, 255, 0.07);
    flex-direction: column;
}

.loadout-badge.is-equipped {
    background-color: rgba(0, 255, 160, 0.16);
}

.loadout-badge.is-preview {
    background-color: rgba(255, 210, 80, 0.14);
}

.color-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    justify-content: center;
    align-items: center;
}

.color-popover {
    width: 320px;
    padding: 12px;
    background-color: rgba(15, 15, 15, 0.95);
    border-radius: 12px;
}

.color-popover-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.color-preview {
    height: 46px;
    border-radius: 10px;
    margin-bottom: 10px;
}

.hsv-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.hsv-label {
    width: 18px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 11px;
    unity-text-align: middle-left;
}

.color-slider {
    flex-grow: 1;
}

.color-presets {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
}

.color-preset-swatch {
    width: 28px;
    height: 28px;
    border-radius: 8px;
}

.loadout-top-row {
    flex-direction: row;
    align-items: stretch;
    gap: 10px;
    margin-top: 6px;
}

.skin-mini {
    width: 86px;
    flex-shrink: 0;
    padding: 8px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    flex-direction: column;
    justify-content: center;
}

.skin-mini-title {
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    unity-font-style: bold;
    margin-bottom: 6px;
}

.skin-mini-swatch {
    height: 28px;
    border-radius: 10px;
}

.eye-mini-row {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 8px;
    margin-top: 0;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    flex-direction: row;
    align-items: center;
    gap: 8px;
    position: relative;
}

.gear-mini-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 8px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
}

.gear-mini-gear {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 8px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    position: relative;
    flex-direction: row;
    align-items: flex-end;
    gap: 6px;
    padding-top: 20px;
    justify-content: flex-start;
    -unity-text-align: middle-left;
    white-space: normal;
    text-overflow: clip;
}

.gear-mini-gear .loadout-text {
    min-width: 0;
}

.gear-mini-color {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    justify-content: center;
    align-items: center;
}

.gear-mini-pattern {
    width: 72px;
    flex-shrink: 0;
    padding: 6px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    flex-direction: column;
    justify-content: center;
}

.loadout-sub.tiny {
    font-size: 9px;
    margin-top: 4px;
    opacity: 0.7;
    unity-text-align: middle-center;
}

.color-swatch.mini {
    width: 28px;
    height: 28px;
    border-radius: 10px;
}

.loadout-icon.mini {
    width: 28px;
    height: 28px;
    border-radius: 10px;
}

.pattern-thumb.mini {
    width: 100%;
    height: 22px;
    border-radius: 8px;
}

.loadout-badge {
    position: absolute;
    top: 6px;
    right: 6px;
}

.is-equipped {
}

/* Loadout pattern target highlight (when Patterns tab is active) */
.is-pattern-target {
    outline-width: 2px;
    outline-style: solid;
    outline-color: rgba(255,255,255,0.85);
    background-color: rgba(255,255,255,0.08);
}
