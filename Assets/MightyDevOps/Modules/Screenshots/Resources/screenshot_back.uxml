<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/MightyDevOps/Resources/UI/mightystyles.uss?fileID=7433441132597879392&amp;guid=3a12c74554a75444aa3e6d5c626c9704&amp;type=3#mightystyles" />
    <ui:VisualElement name="back" class="mappable" style="background-color: rgba(36, 36, 36, 0.65); margin-top: 0; top: auto; align-items: stretch; justify-content: flex-start; flex-direction: column; flex-wrap: nowrap; left: auto; max-width: 256px; max-height: 256px; scale: 1 1; transition-duration: 0.1s; opacity: 1; flex-grow: 0; width: 256px; height: 256px;">
        <ui:VisualElement name="backTop" style="flex-grow: 0; background-color: rgb(0, 0, 0); flex-direction: column; flex-shrink: 0;">
            <ui:Button text="Back" display-tooltip-when-elided="true" name="ssBack" class="back" style="flex-shrink: 0; height: 11px; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; font-size: 10px; background-color: rgb(67, 67, 67); color: rgb(255, 255, 255); flex-grow: 0;" />
        </ui:VisualElement>
        <ui:TextField picking-mode="Ignore" value="Name Me" name="ssName" style="flex-grow: 0; flex-shrink: 0; height: 24px;" />
        <ToggleButton text="Always Show" name="ssAlwaysShow" style="height: 16px;" />
        <ui:Button display-tooltip-when-elided="true" name="screenshot_large" style="flex-shrink: 1; flex-grow: 1; width: 100%; height: 100%; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; background-color: rgba(0, 0, 0, 0);" />
    </ui:VisualElement>
</ui:UXML>
